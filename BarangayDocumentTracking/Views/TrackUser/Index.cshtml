@{
    ViewData["Title"] = "Track Request";
    Layout = null;

    var document = ViewBag.Document;
    var error = ViewBag.Error;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Track Request - Barangay Document Tracking
    </title>


    <!-- Bootswatch Flatly -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css">


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <style>

            * {
                box-sizing: border-box;
            }


            html,
            body {
                margin: 0;
                padding: 0;
                min-height: 100%;
            }


            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
                background: #f4f6f8;
                color: #2c3e50;
            }


            /* =========================================
                       HEADER
                       ========================================= */

            .site-header {
                background: #ffffff;
                height: 80px;
                display: flex;
                align-items: center;
                padding: 0 40px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);
            }


            .header-content {
                width: 100%;
                max-width: 1200px;
                margin: auto;
                display: flex;
                align-items: center;
            }


            .header-logo {
                width: 52px;
                height: 52px;
                object-fit: contain;
                margin-right: 14px;
            }


            .header-title {
                margin: 0;
                font-size: 20px;
                font-weight: 700;
                color: #2c3e50;
            }


            .header-subtitle {
                margin: 3px 0 0;
                font-size: 12px;
                color: #7f8c8d;
            }


            .login-btn {
                margin-left: auto;
                text-decoration: none;
                font-size: 13px;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 7px;
            }


            /* =========================================
                       MAIN
                       ========================================= */

            .page-container {
                max-width: 1000px;
                margin: 0 auto;
                padding: 45px 20px;
            }


            /* =========================================
                       SEARCH CARD
                       ========================================= */

            .search-card {
                background: #ffffff;
                border-radius: 6px;
                padding: 30px;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
                margin-bottom: 25px;
            }


            .search-title {
                text-align: center;
                margin-bottom: 25px;
            }


            .search-icon {
                width: 55px;
                height: 55px;
                border-radius: 50%;
                background: rgba(52, 152, 219, 0.10);
                color: #3498db;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 15px;
                font-size: 25px;
            }


            .search-title h3 {
                margin: 0;
                font-size: 23px;
                font-weight: 700;
            }


            .search-title p {
                margin: 7px 0 0;
                color: #7f8c8d;
                font-size: 13px;
            }


            .tracking-input {
                height: 48px;
                font-size: 14px;
            }


            .track-button {
                height: 48px;
                font-weight: 600;
            }


            /* =========================================
                       ERROR
                       ========================================= */

            .error-message {
                margin-top: 20px;
                margin-bottom: 0;
            }


            /* =========================================
                       DOCUMENT CARD
                       ========================================= */

            .document-card {
                background: #ffffff;
                border-radius: 6px;
                overflow: hidden;
                box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            }


            .document-header {
                background: #2c3e50;
                color: #ffffff;
                padding: 25px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }


                .document-header h4 {
                    margin: 0;
                    font-size: 20px;
                    font-weight: 700;
                }


            .tracking-number {
                margin-top: 5px;
                font-size: 12px;
                color: #bdc3c7;
            }


            .status-badge {
                padding: 7px 13px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
            }


            .status-processing {
                background: #f39c12;
                color: #ffffff;
            }


            .status-completed {
                background: #18bc9c;
                color: #ffffff;
            }


            .status-pending {
                background: #95a5a6;
                color: #ffffff;
            }


            /* =========================================
                       DOCUMENT INFORMATION
                       ========================================= */

            .document-body {
                padding: 30px;
            }


            .info-label {
                display: block;
                font-size: 11px;
                color: #7f8c8d;
                text-transform: uppercase;
                font-weight: 600;
                margin-bottom: 4px;
            }


            .info-value {
                font-size: 14px;
                color: #2c3e50;
                font-weight: 500;
            }


            .description {
                background: #f8f9fa;
                border-radius: 5px;
                padding: 15px;
                margin-top: 25px;
                font-size: 13px;
                color: #6c757d;
            }


            /* =========================================
                       TRACKING HISTORY
                       ========================================= */

            .history-section {
                margin-top: 30px;
            }


            .section-title {
                font-size: 17px;
                font-weight: 700;
                margin-bottom: 20px;
            }


            .timeline {
                position: relative;
                margin-left: 12px;
            }


                .timeline::before {
                    content: "";
                    position: absolute;
                    left: 15px;
                    top: 10px;
                    bottom: 10px;
                    width: 2px;
                    background: #e9ecef;
                }


            .timeline-item {
                position: relative;
                display: flex;
                gap: 18px;
                margin-bottom: 25px;
            }


            .timeline-icon {
                position: relative;
                z-index: 2;
                width: 32px;
                height: 32px;
                min-width: 32px;
                border-radius: 50%;
                background: #3498db;
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }


            .timeline-content {
                padding-top: 1px;
            }


            .timeline-title {
                font-size: 14px;
                font-weight: 600;
                color: #2c3e50;
            }


            .timeline-description {
                font-size: 12px;
                color: #7f8c8d;
                margin-top: 3px;
            }


            .timeline-date {
                font-size: 11px;
                color: #adb5bd;
                margin-top: 5px;
            }


            /* =========================================
                       FOOTER
                       ========================================= */

            .footer {
                text-align: center;
                color: #95a5a6;
                font-size: 12px;
                padding: 20px;
            }


            /* =========================================
                       MOBILE
                       ========================================= */

            @@media (max-width: 600px) {

                .site-header {
                    height: 70px;
                    padding: 0 15px;
                }


                .header-logo {
                    width: 42px;
                    height: 42px;
                    margin-right: 10px;
                }


                .header-title {
                    font-size: 15px;
                }


                .header-subtitle {
                    font-size: 9px;
                }


                .login-btn span {
                    display: none;
                }


                .page-container {
                    padding: 25px 15px;
                }


                .search-card {
                    padding: 25px 20px;
                }


                .document-header {
                    padding: 20px;
                    align-items: flex-start;
                    gap: 15px;
                    flex-direction: column;
                }


                .document-body {
                    padding: 20px;
                }
            }

    </style>

</head>


<body>


    <!-- =========================================
         HEADER
         ========================================= -->

    <header class="site-header">

        <div class="header-content">


            <img src="~/img/barangay_logo.png"
                 alt="Barangay Logo"
                 class="header-logo" />


            <div>

                <h1 class="header-title">
                    Barangay Document Tracking
                </h1>

                <p class="header-subtitle">
                    Document Management System
                </p>

            </div>


            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary login-btn">

                <i class="bi bi-box-arrow-in-right"></i>

                <span>Login</span>

            </a>

        </div>

    </header>



    <!-- =========================================
         MAIN CONTENT
         ========================================= -->

    <main class="page-container">


        <!-- =====================================
             SEARCH
             ===================================== -->

        <div class="search-card">


            <div class="search-title">

                <div class="search-icon">

                    <i class="bi bi-search"></i>

                </div>


                <h3>
                    Track Your Request
                </h3>


                <p>
                    Enter your tracking number to view
                    your document status and history.
                </p>

            </div>



            <form asp-controller="TrackUser"
                  asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-9">

                        <input type="text"
                               name="trackingNumber"
                               class="form-control tracking-input"
                               placeholder="Enter tracking number (e.g. DOC-001)"
                               value="@ViewBag.TrackingNumber"
                               autocomplete="off"
                               required />

                    </div>


                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary w-100 track-button">

                            <i class="bi bi-search me-1"></i>

                            Track Request

                        </button>

                    </div>

                </div>

            </form>



            <!-- ERROR -->
            @if (error != null)
            {
                <div class="alert alert-danger error-message">

                    <i class="bi bi-exclamation-circle me-2"></i>

                    @error

                </div>
            }


        </div>



        <!-- =====================================
             DOCUMENT INFORMATION
             ===================================== -->
        @if (document != null)
        {

            <div class="document-card">


                <!-- DOCUMENT HEADER -->

                <div class="document-header">


                    <div>

                        <h4>
                            @document.DocumentTitle
                        </h4>

                        <div class="tracking-number">

                            Tracking Number:

                            <strong>
                                @document.TrackingNumber
                            </strong>

                        </div>

                    </div>


                    <!-- STATUS -->
                    @if (document.Status == "Completed")
                    {
                        <span class="status-badge status-completed">

                            <i class="bi bi-check-circle me-1"></i>

                            @document.Status

                        </span>
                    }
                    else if (document.Status == "Processing")
                    {
                        <span class="status-badge status-processing">

                            <i class="bi bi-hourglass-split me-1"></i>

                            @document.Status

                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-pending">

                            <i class="bi bi-clock me-1"></i>

                            @document.Status

                        </span>
                    }


                </div>



                <!-- DOCUMENT BODY -->

                <div class="document-body">


                    <!-- INFORMATION -->

                    <div class="row g-4">


                        <div class="col-md-4">

                            <span class="info-label">
                                Document Type
                            </span>

                            <span class="info-value">
                                @document.DocumentType
                            </span>

                        </div>


                        <div class="col-md-4">

                            <span class="info-label">
                                Date Received
                            </span>

                            <span class="info-value">
                                @document.DateReceived
                            </span>

                        </div>


                        <div class="col-md-4">

                            <span class="info-label">
                                Priority
                            </span>

                            <span class="info-value">
                                @document.Priority
                            </span>

                        </div>


                        <div class="col-md-4">

                            <span class="info-label">
                                Source
                            </span>

                            <span class="info-value">
                                @document.Source
                            </span>

                        </div>


                        <div class="col-md-4">

                            <span class="info-label">
                                Sender
                            </span>

                            <span class="info-value">
                                @document.Sender
                            </span>

                        </div>


                        <div class="col-md-4">

                            <span class="info-label">
                                Current Handler
                            </span>

                            <span class="info-value">
                                @document.CurrentHandler
                            </span>

                        </div>


                        <div class="col-md-12">

                            <span class="info-label">
                                Current Location
                            </span>

                            <span class="info-value">
                                @document.CurrentLocation
                            </span>

                        </div>


                    </div>



                    <!-- DESCRIPTION -->

                    <div class="description">

                        <strong>
                            Description
                        </strong>

                        <br />

                        @document.Description

                    </div>



                    <!-- =================================
                         HISTORY
                         ================================= -->

                    <div class="history-section">

                        <div class="section-title">

                            <i class="bi bi-clock-history me-2"></i>

                            Request History

                        </div>


                        <div class="timeline">

                            @foreach (var history in document.History)
                            {

                                <div class="timeline-item">


                                    <div class="timeline-icon">

                                        <i class="bi @history.Icon"></i>

                                    </div>


                                    <div class="timeline-content">

                                        <div class="timeline-title">

                                            @history.Title

                                        </div>


                                        <div class="timeline-description">

                                            @history.Description

                                        </div>


                                        <div class="timeline-date">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @history.Date

                                            <span class="mx-1">•</span>

                                            <i class="bi bi-clock me-1"></i>

                                            @history.Time

                                        </div>

                                    </div>

                                </div>

                            }

                        </div>

                    </div>


                </div>

            </div>

        }

    </main>



    <!-- FOOTER -->

    <footer class="footer">

        Barangay Document Tracking System

    </footer>



    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>

</html>