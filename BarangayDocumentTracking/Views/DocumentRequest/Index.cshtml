
@model List<BarangayDocumentTracking.Models.Document>

@{
    ViewData["Title"] = "Request Documents";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">
            <i class="bi bi-file-earmark-text text-primary"></i>
            Request Documents
        </h2>

        <p class="text-muted">
            Select a document that you would like to request.
        </p>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Email Warning -->
    @if (TempData["EmailWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["EmailWarning"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-x-circle-fill me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Available Documents -->
    <div class="row g-4">

        @if (Model != null && Model.Any())
        {
            foreach (var document in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body p-4">

                            <!-- Document Code -->
                            <div class="mb-3">
                                <span class="badge bg-primary">
                                    @document.DocumentCode
                                </span>
                            </div>

                            <!-- Document Name -->
                            <h4 class="fw-bold">
                                @document.DocumentName
                            </h4>

                            <!-- Description -->
                            <p class="text-muted">
                                @document.Description
                            </p>

                            <hr />

                            <!-- Requirements -->
                            <div class="mb-3">
                                <div class="fw-semibold">
                                    <i class="bi bi-list-check text-primary"></i>
                                    Requirements
                                </div>

                                <small class="text-muted">
                                    @(string.IsNullOrWhiteSpace(document.Requirements)
                                        ? "No requirements specified."
                                        : document.Requirements)
                                </small>
                            </div>

                            <!-- Processing Time -->
                            <div class="mb-3">
                                <div class="fw-semibold">
                                    <i class="bi bi-clock text-primary"></i>
                                    Processing Time
                                </div>

                                <small class="text-muted">
                                    @(string.IsNullOrWhiteSpace(document.ProcessingTime)
                                        ? "Not specified."
                                        : document.ProcessingTime)
                                </small>
                            </div>

                            <!-- Fee -->
                            <div class="mb-3">
                                <div class="fw-semibold">
                                    <i class="bi bi-cash text-primary"></i>
                                    Document Fee
                                </div>

                                @if (document.Fee == 0)
                                {
                                    <span class="text-success fw-bold">
                                        FREE
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold">
                                        ₱@document.Fee.ToString("N2")
                                    </span>
                                }
                            </div>

                        </div>

                        <!-- Request Button -->
                        <div class="card-footer bg-white border-0 p-3">

                            <a asp-controller="DocumentRequest"
                               asp-action="AddDocumentFillup"
                               asp-route-id="@document.Id"
                               class="btn btn-success w-100">

                                <i class="bi bi-file-earmark-plus me-1"></i>
                                Request This Document

                            </a>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">

                        <i class="bi bi-folder2-open text-muted"
                           style="font-size: 3rem;"></i>

                        <h5 class="fw-bold mt-3">
                            No Documents Available
                        </h5>

                        <p class="text-muted mb-0">
                            No documents are currently available for request.
                            Please check again later.
                        </p>

                    </div>
                </div>

            </div>
        }

    </div>

</div>
