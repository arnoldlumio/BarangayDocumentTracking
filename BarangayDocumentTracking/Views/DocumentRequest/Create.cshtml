
@model BarangayDocumentTracking.Models.DocumentRequest

@{
    ViewData["Title"] = "Submit Document Request";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="DocumentRequest"
           asp-action="AddDocumentFillup"
           asp-route-id="@Model.DocumentId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

    <div class="card shadow-sm border-0 mx-auto" style="max-width: 800px;">

        <div class="card-header bg-primary text-white p-4">
            <h4 class="fw-bold mb-1">
                <i class="bi bi-file-earmark-plus"></i>
                Resident Document Request Form
            </h4>
            <p class="mb-0">
                Please provide your correct information.
            </p>
        </div>

        <div class="card-body p-4">

            <!-- Selected Document -->
            <div class="bg-light rounded p-3 mb-4">
                <h6 class="text-primary fw-bold mb-3">
                    <i class="bi bi-file-earmark-check"></i>
                    Selected Document
                </h6>

                <div class="row">
                    <div class="col-md-6 mb-2">
                        <small class="text-muted">Document Code</small>
                        <div class="fw-bold">
                            @Model.Document?.DocumentCode
                        </div>
                    </div>

                    <div class="col-md-6 mb-2">
                        <small class="text-muted">Document Name</small>
                        <div class="fw-bold">
                            @Model.Document?.DocumentName
                        </div>
                    </div>

                    <div class="col-md-6 mb-2">
                        <small class="text-muted">Processing Time</small>
                        <div>
                            @Model.Document?.ProcessingTime
                        </div>
                    </div>

                    <div class="col-md-6 mb-2">
                        <small class="text-muted">Document Fee</small>
                        <div class="fw-bold text-success">
                            @if (Model.Document?.Fee == 0)
                            {
                                <span>FREE</span>
                            }
                            else if (Model.Document != null)
                            {
                                <span>₱@Model.Document.Fee.ToString("N2")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <h5 class="fw-bold mb-3">
                <i class="bi bi-person-lines-fill text-primary"></i>
                Personal Information
            </h5>

            <form asp-controller="DocumentRequest"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="DocumentId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ResidentName"
                           class="form-label fw-semibold"></label>

                    <input asp-for="ResidentName"
                           class="form-control"
                           placeholder="Enter your complete name" />

                    <span asp-validation-for="ResidentName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label fw-semibold"></label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@email.com" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address"
                           class="form-label fw-semibold"></label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="2"
                              placeholder="House No., Street, Purok, Barangay"></textarea>

                    <span asp-validation-for="Address"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactNumber"
                           class="form-label fw-semibold"></label>

                    <input asp-for="ContactNumber"
                           type="tel"
                           class="form-control"
                           placeholder="Enter your contact number" />

                    <span asp-validation-for="ContactNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Purpose"
                           class="form-label fw-semibold"></label>

                    <textarea asp-for="Purpose"
                              class="form-control"
                              rows="3"
                              placeholder="Explain why you need this document"></textarea>

                    <span asp-validation-for="Purpose"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="DocumentRequest"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-success px-4">
                        <i class="bi bi-send"></i>
                        Submit Request
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
