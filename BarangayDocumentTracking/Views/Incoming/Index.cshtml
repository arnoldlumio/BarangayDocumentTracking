@{
    ViewData["Title"] = "Incoming Documents";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">

    <h4>Incoming Documents</h4>

    <p class="text-muted">
        View documents received by the barangay office.
    </p>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        <h5 class="mb-3">
            Incoming Document List
        </h5>

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>

                    <tr>
                        <th>Document No.</th>
                        <th>Sender</th>
                        <th>Subject</th>
                        <th>Date Received</th>
                        <th>Status</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>INC-001</td>

                        <td>
                            Municipal Office
                        </td>

                        <td>
                            Request Letter
                        </td>

                        <td>
                            September 15, 2026
                        </td>

                        <td>
                            <span class="badge bg-info">
                                Received
                            </span>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>