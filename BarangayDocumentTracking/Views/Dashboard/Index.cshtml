@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ==========================================
     DASHBOARD CARD CUSTOM COLORS
     ========================================== -->

<style>

    /* ==========================================
           COLORED DASHBOARD CARDS
           FLATLY COLORS
           ========================================== */

    .dashboard-card {
        border: none !important;
        border-radius: 7px !important;
        padding: 20px !important;
        color: #ffffff !important;
        min-height: 150px;
        box-shadow: none !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }


        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15) !important;
        }


    /* ==========================================
           ORANGE
           ========================================== */

    .dashboard-card-orange {
        background: #f39c12 !important;
    }


    /* ==========================================
           TEAL
           ========================================== */

    .dashboard-card-teal {
        background: #1abc9c !important;
    }


    /* ==========================================
           BLUE
           ========================================== */

    .dashboard-card-blue {
        background: #3498db !important;
    }


    /* ==========================================
           DARK GRAY
           ========================================== */

    .dashboard-card-dark {
        background: #2c3e50 !important;
    }


    /* ==========================================
           CARD ICON
           ========================================== */

    .dashboard-card .card-icon {
        width: 48px;
        height: 48px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 15px;
        background: rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
    }


    /* ==========================================
           CARD LABEL
           ========================================== */

    .dashboard-card .card-label {
        color: rgba(255, 255, 255, 0.90) !important;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 3px;
    }


    /* ==========================================
           CARD NUMBER
           ========================================== */

    .dashboard-card .card-number {
        color: #ffffff !important;
        font-size: 30px;
        font-weight: 700;
        margin: 0;
    }


    /* ==========================================
           MOBILE
           ========================================== */

    @@media (max-width: 576px) {

        .dashboard-card {
            min-height: 140px;
        }

            .dashboard-card .card-number {
                font-size: 26px;
            }
    }

</style>



<!-- ==========================================
     WELCOME
     ========================================== -->

<div class="mb-4">

    <h4 class="fw-bold mb-1">
        Welcome, @ViewBag.Username!
    </h4>

    <p class="text-muted mb-0">
        Here's an overview of your Barangay Document Tracking System.
    </p>

</div>



<!-- ==========================================
     SUMMARY CARDS
     ========================================== -->

<div class="row g-3 mb-4">


    <!-- ======================================
         TOTAL DOCUMENTS
         ORANGE
         ====================================== -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="dashboard-card dashboard-card-orange">

            <div class="card-icon">

                <i class="bi bi-file-earmark-text"></i>

            </div>


            <div class="card-label">

                Total Documents

            </div>


            <h3 class="card-number">

                128

            </h3>

        </div>

    </div>



    <!-- ======================================
         INCOMING DOCUMENTS
         TEAL
         ====================================== -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="dashboard-card dashboard-card-teal">

            <div class="card-icon">

                <i class="bi bi-box-arrow-in-down"></i>

            </div>


            <div class="card-label">

                Incoming Documents

            </div>


            <h3 class="card-number">

                45

            </h3>

        </div>

    </div>



    <!-- ======================================
         OUTGOING DOCUMENTS
         BLUE
         ====================================== -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="dashboard-card dashboard-card-blue">

            <div class="card-icon">

                <i class="bi bi-box-arrow-up"></i>

            </div>


            <div class="card-label">

                Outgoing Documents

            </div>


            <h3 class="card-number">

                36

            </h3>

        </div>

    </div>



    <!-- ======================================
         PROCESSING
         DARK GRAY
         ====================================== -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="dashboard-card dashboard-card-dark">

            <div class="card-icon">

                <i class="bi bi-clock-history"></i>

            </div>


            <div class="card-label">

                Processing

            </div>


            <h3 class="card-number">

                47

            </h3>

        </div>

    </div>

</div>



<!-- ==========================================
     RECENT DOCUMENTS
     ========================================== -->

<div class="content-card">


    <!-- ======================================
         CARD HEADER
         ====================================== -->

    <div class="content-card-header">

        <h5 class="content-card-title">

            Recent Documents

        </h5>


        <a asp-controller="Documents"
           asp-action="Index"
           class="btn btn-sm btn-outline-primary">

            View All

        </a>

    </div>



    <!-- ======================================
         CARD BODY
         ====================================== -->

    <div class="content-card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Document No.
                        </th>

                        <th>
                            Document
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <!-- ==================================
                         DOCUMENT 1
                         ================================== -->

                    <tr>

                        <td class="ps-4 fw-semibold">
                            DOC-001
                        </td>

                        <td>
                            Barangay Resolution
                        </td>

                        <td>
                            Resolution
                        </td>

                        <td>
                            Sep 15, 2026
                        </td>

                        <td>

                            <span class="badge bg-success">

                                Completed

                            </span>

                        </td>

                    </tr>



                    <!-- ==================================
                         DOCUMENT 2
                         ================================== -->

                    <tr>

                        <td class="ps-4 fw-semibold">
                            DOC-002
                        </td>

                        <td>
                            Certificate Request
                        </td>

                        <td>
                            Certificate
                        </td>

                        <td>
                            Sep 15, 2026
                        </td>

                        <td>

                            <span class="badge bg-warning text-dark">

                                Processing

                            </span>

                        </td>

                    </tr>



                    <!-- ==================================
                         DOCUMENT 3
                         ================================== -->

                    <tr>

                        <td class="ps-4 fw-semibold">
                            DOC-003
                        </td>

                        <td>
                            Request Letter
                        </td>

                        <td>
                            Incoming
                        </td>

                        <td>
                            Sep 14, 2026
                        </td>

                        <td>

                            <span class="badge bg-info">

                                Received

                            </span>

                        </td>

                    </tr>



                    <!-- ==================================
                         DOCUMENT 4
                         ================================== -->

                    <tr>

                        <td class="ps-4 fw-semibold">
                            DOC-004
                        </td>

                        <td>
                            Barangay Clearance
                        </td>

                        <td>
                            Certificate
                        </td>

                        <td>
                            Sep 14, 2026
                        </td>

                        <td>

                            <span class="badge bg-success">

                                Completed

                            </span>

                        </td>

                    </tr>



                    <!-- ==================================
                         DOCUMENT 5
                         ================================== -->

                    <tr>

                        <td class="ps-4 fw-semibold">
                            DOC-005
                        </td>

                        <td>
                            Endorsement Letter
                        </td>

                        <td>
                            Outgoing
                        </td>

                        <td>
                            Sep 13, 2026
                        </td>

                        <td>

                            <span class="badge bg-primary">

                                Released

                            </span>

                        </td>

                    </tr>


                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- ==========================================
     QUICK ACTIONS
     ========================================== -->

<div class="row g-3 mt-3">


    <!-- ======================================
         ADD DOCUMENT
         ====================================== -->

    <div class="col-md-4">

        <a asp-controller="Documents"
           asp-action="Create"
           class="text-decoration-none">

            <div class="content-card h-100">

                <div class="content-card-body">

                    <i class="bi bi-plus-circle fs-3 text-primary"></i>


                    <h6 class="mt-3 mb-1 text-dark">

                        Add New Document

                    </h6>


                    <p class="text-muted small mb-0">

                        Register a new document in the system.

                    </p>

                </div>

            </div>

        </a>

    </div>



    <!-- ======================================
         TRACK DOCUMENT
         ====================================== -->

    <div class="col-md-4">

        <a asp-controller="Tracking"
           asp-action="Index"
           class="text-decoration-none">

            <div class="content-card h-100">

                <div class="content-card-body">

                    <i class="bi bi-search fs-3 text-primary"></i>


                    <h6 class="mt-3 mb-1 text-dark">

                        Track Document

                    </h6>


                    <p class="text-muted small mb-0">

                        Search and check document status.

                    </p>

                </div>

            </div>

        </a>

    </div>



    <!-- ======================================
         REPORTS
         ====================================== -->

    <div class="col-md-4">

        <a asp-controller="Reports"
           asp-action="Index"
           class="text-decoration-none">

            <div class="content-card h-100">

                <div class="content-card-body">

                    <i class="bi bi-bar-chart fs-3 text-primary"></i>


                    <h6 class="mt-3 mb-1 text-dark">

                        View Reports

                    </h6>


                    <p class="text-muted small mb-0">

                        Generate document tracking reports.

                    </p>

                </div>

            </div>

        </a>

    </div>

</div>