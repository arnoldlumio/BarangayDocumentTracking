@model IEnumerable<BarangayDocumentTracking.Models.Document>

@{
    ViewData["Title"] = "Documents";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h4 class="mb-1">Documents</h4>

        <p class="text-muted mb-0">
            Manage the documents and certificates available for resident requests.
        </p>
    </div>

    <a asp-controller="Documents"
       asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-lg me-1"></i>
        Add Document

    </a>

</div>


<!-- SUCCESS MESSAGE -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- DOCUMENT LIST -->
<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Available Documents
                </h5>

                <small class="text-muted">
                    Documents that residents can request
                </small>
            </div>

            <span class="badge bg-primary">
                @Model.Count() Documents
            </span>

        </div>

    </div>


    <div class="card-body">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Code
                            </th>

                            <th>
                                Document
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Processing Time
                            </th>

                            <th>
                                Fee
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var document in Model)
                        {
                            <tr>

                                <!-- DOCUMENT CODE -->
                                <td>

                                    <span class="fw-semibold">
                                        @document.DocumentCode
                                    </span>

                                </td>


                                <!-- DOCUMENT NAME -->
                                <td>

                                    <div class="fw-semibold">
                                        @document.DocumentName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(document.Requirements))
                                    {
                                        <small class="text-muted">

                                            <i class="bi bi-check2-square me-1"></i>

                                            Requirements available

                                        </small>
                                    }

                                </td>


                                <!-- DESCRIPTION -->
                                <td style="min-width: 250px;">

                                    <span>
                                        @document.Description
                                    </span>

                                </td>


                                <!-- PROCESSING TIME -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(document.ProcessingTime))
                                    {
                                        <span>

                                            <i class="bi bi-clock me-1"></i>

                                            @document.ProcessingTime

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not specified
                                        </span>
                                    }

                                </td>


                                <!-- FEE -->
                                <td>

                                    @if (document.Fee == 0)
                                    {
                                        <span class="badge bg-success">
                                            Free
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">
                                            ₱@document.Fee.ToString("N2")
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (document.Status == "Available")
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Available

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="bi bi-x-circle me-1"></i>

                                            @document.Status

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end">

                                    <!-- DETAILS -->
                                    <a asp-controller="Documents"
                                       asp-action="Details"
                                       asp-route-id="@document.Id"
                                       class="btn btn-sm btn-info text-white"
                                       title="View Details">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <!-- EDIT -->
                                    <a asp-controller="Documents"
                                       asp-action="Edit"
                                       asp-route-id="@document.Id"
                                       class="btn btn-sm btn-warning"
                                       title="Edit Document">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- EMPTY STATE -->

            <div class="text-center py-5">

                <div class="mb-3">

                    <i class="bi bi-file-earmark-x"
                       style="font-size: 50px;">
                    </i>

                </div>

                <h5>
                    No Documents Available
                </h5>

                <p class="text-muted mb-4">
                    There are currently no documents available
                    for resident requests.
                </p>

                <a asp-controller="Documents"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>

                    Add First Document

                </a>

            </div>
        }

    </div>

</div>