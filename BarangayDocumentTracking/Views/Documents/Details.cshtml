@model BarangayDocumentTracking.Models.Document

@{
    ViewData["Title"] = "Document Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .details-header {
        margin-bottom: 25px;
    }

    .details-header h4 {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .details-header p {
        color: #7f8c8d;
        margin-bottom: 0;
    }

    .details-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .details-card {
        background: #ffffff;
        border: 1px solid #e5e9ed;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        margin-bottom: 20px;
    }

    .details-card-header {
        background: #2c3e50;
        color: #ffffff;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .details-card-title {
        margin: 0;
        font-size: 17px;
        font-weight: 600;
    }

    .details-card-subtitle {
        font-size: 12px;
        color: rgba(255,255,255,0.7);
        margin-top: 4px;
    }

    .document-code-box {
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .details-card-body {
        padding: 25px;
    }

    .info-item {
        margin-bottom: 20px;
    }

    .info-item:last-child {
        margin-bottom: 0;
    }

    .info-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #95a5a6;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: 14px;
        font-weight: 500;
        color: #2c3e50;
    }

    .info-value-large {
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
    }

    .status-box {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-available {
        background: #e8f8f4;
        color: #18bc9c;
    }

    .status-unavailable {
        background: #fdeeee;
        color: #e74c3c;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        background: currentColor;
        border-radius: 50%;
    }

    .description-box {
        background: #f8f9fa;
        border: 1px solid #e5e9ed;
        border-radius: 6px;
        padding: 15px;
        color: #5f6b73;
        font-size: 13px;
        line-height: 1.6;
    }

    .requirements-box {
        background: #f8f9fa;
        border: 1px solid #e5e9ed;
        border-radius: 6px;
        padding: 15px;
        color: #5f6b73;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-line;
    }

    .summary-box {
        background: #f8f9fa;
        border: 1px solid #e5e9ed;
        border-radius: 7px;
        padding: 18px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }

    .summary-item:last-child {
        margin-bottom: 0;
    }

    .summary-icon {
        width: 38px;
        height: 38px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf4fb;
        color: #3498db;
        flex-shrink: 0;
    }

    .summary-label {
        font-size: 10px;
        color: #95a5a6;
        text-transform: uppercase;
        font-weight: 700;
    }

    .summary-value {
        font-size: 13px;
        color: #2c3e50;
        font-weight: 600;
        margin-top: 2px;
    }

    @@media (max-width: 768px) {

        .details-card-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .details-card-body {
            padding: 20px;
        }

        .details-actions {
            width: 100%;
        }

        .details-actions .btn {
            flex: 1;
        }
    }

    @@media print {

        .sidebar,
        .top-navbar,
        .details-actions,
        .no-print {
            display: none !important;
        }

        .main-wrapper {
            margin-left: 0 !important;
        }

        .content {
            padding: 0 !important;
        }

        .details-card {
            box-shadow: none !important;
            border: 1px solid #ddd;
        }
    }

</style>


<!-- ==========================================
     PAGE HEADER
     ========================================== -->

<div class="details-header">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>

            <h4>
                Document Details
            </h4>

            <p>
                View information about this document available for resident requests.
            </p>

        </div>


        <!-- ACTIONS -->

        <div class="details-actions no-print">

            <a asp-controller="Documents"
               asp-action="Index"
               class="btn btn-sm btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Back

            </a>


            <a asp-controller="Documents"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-sm btn-warning">

                <i class="bi bi-pencil me-1"></i>

                Edit

            </a>


            <button type="button"
                    class="btn btn-sm btn-primary"
                    onclick="window.print()">

                <i class="bi bi-printer me-1"></i>

                Print

            </button>

        </div>

    </div>

</div>


<!-- ==========================================
     DOCUMENT INFORMATION
     ========================================== -->

<div class="details-card">

    <!-- HEADER -->

    <div class="details-card-header">

        <div>

            <h5 class="details-card-title">

                @Model.DocumentName

            </h5>

            <div class="details-card-subtitle">

                Document available for resident requests

            </div>

        </div>


        <div class="document-code-box">

            @Model.DocumentCode

        </div>

    </div>


    <!-- BODY -->

    <div class="details-card-body">

        <div class="row">


            <!-- DOCUMENT NAME -->

            <div class="col-md-8">

                <div class="info-item">

                    <span class="info-label">
                        Document Name
                    </span>

                    <div class="info-value-large">

                        @Model.DocumentName

                    </div>

                </div>

            </div>


            <!-- STATUS -->

            <div class="col-md-4">

                <div class="info-item">

                    <span class="info-label">
                        Status
                    </span>

                    <div class="info-value">

                        @if (Model.Status == "Available")
                        {
                            <span class="status-box status-available">

                                <span class="status-dot"></span>

                                Available

                            </span>
                        }
                        else
                        {
                            <span class="status-box status-unavailable">

                                <span class="status-dot"></span>

                                @Model.Status

                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- DOCUMENT CODE -->

            <div class="col-md-4">

                <div class="info-item">

                    <span class="info-label">
                        Document Code
                    </span>

                    <div class="info-value">

                        @Model.DocumentCode

                    </div>

                </div>

            </div>


            <!-- PROCESSING TIME -->

            <div class="col-md-4">

                <div class="info-item">

                    <span class="info-label">
                        Processing Time
                    </span>

                    <div class="info-value">

                        @if (!string.IsNullOrWhiteSpace(Model.ProcessingTime))
                        {
                            <span>

                                <i class="bi bi-clock me-1"></i>

                                @Model.ProcessingTime

                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not specified
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- PROCESSING FEE -->

            <div class="col-md-4">

                <div class="info-item">

                    <span class="info-label">
                        Processing Fee
                    </span>

                    <div class="info-value">

                        @if (Model.Fee == 0)
                        {
                            <span class="badge bg-success">

                                Free

                            </span>
                        }
                        else
                        {
                            <span class="fw-semibold">

                                ₱@Model.Fee.ToString("N2")

                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- DATE ADDED -->

            <div class="col-md-6">

                <div class="info-item">

                    <span class="info-label">
                        Date Added
                    </span>

                    <div class="info-value">

                        @Model.CreatedAt.ToString("MMMM dd, yyyy")

                    </div>

                </div>

            </div>


        </div>

    </div>

</div>


<!-- ==========================================
     DESCRIPTION
     ========================================== -->

<div class="details-card">

    <div class="details-card-header">

        <div>

            <h5 class="details-card-title">

                Document Description

            </h5>

            <div class="details-card-subtitle">

                Information about this document

            </div>

        </div>

    </div>


    <div class="details-card-body">

        <div class="description-box">

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                @Model.Description
            }
            else
            {
                <span class="text-muted">
                    No description provided.
                </span>
            }

        </div>

    </div>

</div>


<!-- ==========================================
     REQUIREMENTS
     ========================================== -->

<div class="details-card">

    <div class="details-card-header">

        <div>

            <h5 class="details-card-title">

                Requirements

            </h5>

            <div class="details-card-subtitle">

                Requirements that residents need to provide

            </div>

        </div>

    </div>


    <div class="details-card-body">

        <div class="requirements-box">

            @if (!string.IsNullOrWhiteSpace(Model.Requirements))
            {
                @Model.Requirements
            }
            else
            {
                <span class="text-muted">
                    No specific requirements provided.
                </span>
            }

        </div>

    </div>

</div>


<!-- ==========================================
     REQUEST INFORMATION
     ========================================== -->

<div class="details-card">

    <div class="details-card-header">

        <div>

            <h5 class="details-card-title">

                Resident Request Information

            </h5>

            <div class="details-card-subtitle">

                Important information for residents requesting this document

            </div>

        </div>

    </div>


    <div class="details-card-body">

        <div class="summary-box">


            <!-- PROCESSING TIME -->

            <div class="summary-item">

                <div class="summary-icon">

                    <i class="bi bi-clock"></i>

                </div>

                <div>

                    <div class="summary-label">
                        Processing Time
                    </div>

                    <div class="summary-value">

                        @if (!string.IsNullOrWhiteSpace(Model.ProcessingTime))
                        {
                            @Model.ProcessingTime
                        }
                        else
                        {
                            <span class="text-muted">
                                Not specified
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- FEE -->

            <div class="summary-item">

                <div class="summary-icon">

                    <i class="bi bi-cash-coin"></i>

                </div>

                <div>

                    <div class="summary-label">
                        Processing Fee
                    </div>

                    <div class="summary-value">

                        @if (Model.Fee == 0)
                        {
                            <span class="text-success">
                                Free
                            </span>
                        }
                        else
                        {
                            <span>
                                ₱@Model.Fee.ToString("N2")
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- STATUS -->

            <div class="summary-item">

                <div class="summary-icon">

                    <i class="bi bi-check-circle"></i>

                </div>

                <div>

                    <div class="summary-label">
                        Availability
                    </div>

                    <div class="summary-value">

                        @Model.Status

                    </div>

                </div>

            </div>


        </div>

    </div>

</div>


<!-- ==========================================
     BOTTOM ACTIONS
     ========================================== -->

<div class="d-flex justify-content-between align-items-center mt-3 mb-4 no-print">


    <a asp-controller="Documents"
       asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back to Documents

    </a>


    <div class="details-actions">

        <a asp-controller="Documents"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">

            <i class="bi bi-pencil me-1"></i>

            Edit Document

        </a>


        <button type="button"
                class="btn btn-primary"
                onclick="window.print()">

            <i class="bi bi-printer me-1"></i>

            Print Document

        </button>

    </div>

</div>