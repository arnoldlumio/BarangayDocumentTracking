@model BarangayDocumentTracking.Models.Announcement

@{
    ViewData["Title"] = "Create Announcement";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>

    /* =========================================================
           HEADER PUBLISH PROGRESS
           ========================================================= */

    .header-publish-progress {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 99999;
        width: 100%;
        height: 10px;
        border-radius: 0;
        overflow: hidden;
        background-color: #e9ecef;
    }

        .header-publish-progress.show {
            display: block;
        }

        .header-publish-progress .progress-bar {
            height: 10px;
            /*
             * Smooth and slower animation
             */
            transition: width 1.2s ease-in-out;
        }


    /* =========================================================
           PUBLISH STATUS MESSAGE
           ========================================================= */

    .publish-status-message {
        display: none;
        position: fixed;
        top: 16px;
        right: 20px;
        z-index: 99998;
        padding: 8px 14px;
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        color: #495057;
        font-size: 13px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.10);
    }

        .publish-status-message.show {
            display: block;
        }


    /* =========================================================
           ANNOUNCEMENT EDITOR
           ========================================================= */

    .announcement-editor {
        width: 100%;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #ffffff;
        overflow: hidden;
    }


    /* =========================================================
           TOOLBAR
           ========================================================= */

    .editor-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        min-height: 48px;
        padding: 5px 8px;
        background: #ffffff;
        border-bottom: 1px solid #dee2e6;
    }


    .editor-button {
        width: 36px;
        height: 36px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 3px;
        background: transparent;
        color: #555;
        font-size: 18px;
        cursor: pointer;
        transition: all 0.15s ease;
    }


        .editor-button:hover {
            background: #eeeeee;
            color: #000000;
        }


        .editor-button:active {
            background: #dddddd;
        }


        .editor-button.active {
            background: #dfe8f0;
            color: #0d6efd;
        }


    .editor-separator {
        width: 1px;
        height: 26px;
        background: #dee2e6;
        margin: 0 6px;
    }


    .editor-select {
        height: 34px;
        border: none;
        background: transparent;
        color: #555;
        font-size: 14px;
        padding: 0 5px;
        margin-right: 5px;
        outline: none;
        cursor: pointer;
    }


        .editor-select:hover {
            background: #eeeeee;
        }


    /* =========================================================
           EDITOR CONTENT
           ========================================================= */

    .editor-content {
        min-height: 280px;
        max-height: 500px;
        overflow-y: auto;
        padding: 16px;
        background: #ffffff;
        color: #212529;
        font-size: 15px;
        line-height: 1.6;
        outline: none;
        cursor: text;
    }


    .announcement-editor:focus-within {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
    }


    .editor-content:empty::before {
        content: attr(data-placeholder);
        color: #999999;
        pointer-events: none;
    }


    .editor-content p {
        margin-bottom: 10px;
    }


    .editor-content img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 10px 0;
    }


    .editor-content video {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 10px 0;
    }


    .editor-content a {
        color: #0d6efd;
        text-decoration: underline;
    }


    .editor-content blockquote {
        border-left: 4px solid #0d6efd;
        padding-left: 15px;
        margin-left: 0;
        color: #666;
    }


    /* =========================================================
           CHARACTER COUNT
           ========================================================= */

    .character-count {
        font-size: 12px;
        color: #6c757d;
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 768px) {

        .editor-toolbar {
            padding: 5px;
        }

        .editor-button {
            width: 34px;
            height: 34px;
        }

        .editor-content {
            min-height: 220px;
        }

        .publish-status-message {
            top: 12px;
            right: 10px;
            font-size: 12px;
        }
    }

</style>


