                            </span>

                        </div>



                        <!-- =================================================
                             CONTENT
                             ================================================= -->

                        <div class="mb-4">


                            <label asp-for="Content"
                                   class="form-label fw-semibold">

                                Announcement Content

                            </label>



                            <!-- =================================================
                                 RICH TEXT EDITOR
                                 ================================================= -->

                            <div class="announcement-editor">


                                <!-- TOOLBAR -->

                                <div class="editor-toolbar">


                                    <!-- FONT -->

                                    <select class="editor-select"
                                            id="fontName"
                                            title="Font">

                                        <option value="">
                                            Font
                                        </option>

                                        <option value="Arial">
                                            Arial
                                        </option>

                                        <option value="Verdana">
                                            Verdana
                                        </option>

                                        <option value="Georgia">
                                            Georgia
                                        </option>

                                        <option value="Tahoma">
                                            Tahoma
                                        </option>

                                        <option value="Times New Roman">
                                            Times New Roman
                                        </option>

                                    </select>



                                    <!-- SIZE -->

                                    <select class="editor-select"
                                            id="fontSize"
                                            title="Font Size">

                                        <option value="">
                                            Size
                                        </option>

                                        <option value="1">
                                            Small
                                        </option>

                                        <option value="3">
                                            Normal
                                        </option>

                                        <option value="5">
                                            Large
                                        </option>

                                        <option value="7">
                                            Extra Large
                                        </option>

                                    </select>



                                    <span class="editor-separator"></span>



                                    <!-- BOLD -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="bold"
                                            title="Bold">

                                        <i class="bi bi-type-bold"></i>

                                    </button>



                                    <!-- ITALIC -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="italic"
                                            title="Italic">

                                        <i class="bi bi-type-italic"></i>

                                    </button>



                                    <!-- UNDERLINE -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="underline"
                                            title="Underline">

                                        <i class="bi bi-type-underline"></i>

                                    </button>



                                    <!-- STRIKETHROUGH -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="strikeThrough"
                                            title="Strikethrough">

                                        <i class="bi bi-type-strikethrough"></i>

                                    </button>



                                    <span class="editor-separator"></span>



                                    <!-- ALIGN LEFT -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="justifyLeft"
                                            title="Align Left">

                                        <i class="bi bi-text-left"></i>

                                    </button>



                                    <!-- CENTER -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="justifyCenter"
                                            title="Align Center">

                                        <i class="bi bi-text-center"></i>

                                    </button>



                                    <!-- RIGHT -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="justifyRight"
                                            title="Align Right">

                                        <i class="bi bi-text-right"></i>

                                    </button>



                                    <!-- JUSTIFY -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="justifyFull"
                                            title="Justify">

                                        <i class="bi bi-justify"></i>

                                    </button>



                                    <span class="editor-separator"></span>



                                    <!-- BULLET -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="insertUnorderedList"
                                            title="Bullet List">

                                        <i class="bi bi-list-ul"></i>

                                    </button>



                                    <!-- NUMBER -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="insertOrderedList"
                                            title="Numbered List">

                                        <i class="bi bi-list-ol"></i>

                                    </button>



                                    <span class="editor-separator"></span>



                                    <!-- LINK -->

                                    <button type="button"
                                            class="editor-button"
                                            id="linkButton"
                                            title="Insert Link">

                                        <i class="bi bi-link-45deg"></i>

                                    </button>



                                    <!-- REMOVE LINK -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="unlink"
                                            title="Remove Link">

                                        <i class="bi bi-link-45deg"></i>

                                        <span style="font-size:9px;">
                                            ×
                                        </span>

                                    </button>



                                    <!-- FILE -->

                                    <button type="button"
                                            class="editor-button"
                                            id="fileButton"
                                            title="Attach File">

                                        <i class="bi bi-file-earmark"></i>

                                    </button>



                                    <!-- IMAGE -->

                                    <button type="button"
                                            class="editor-button"
                                            id="imageButton"
                                            title="Insert Image">

                                        <i class="bi bi-image"></i>

                                    </button>



                                    <!-- MICROPHONE -->

                                    <button type="button"
                                            class="editor-button"
                                            id="voiceButton"
                                            title="Voice Input">

                                        <i class="bi bi-mic"></i>

                                    </button>



                                    <!-- VIDEO -->

                                    <button type="button"
                                            class="editor-button"
                                            id="videoButton"
                                            title="Insert Video">

                                        <i class="bi bi-camera-video"></i>

                                    </button>



                                    <span class="editor-separator"></span>



                                    <!-- UNDO -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="undo"
                                            title="Undo">

                                        <i class="bi bi-arrow-counterclockwise"></i>

                                    </button>



                                    <!-- REDO -->

                                    <button type="button"
                                            class="editor-button"
                                            data-command="redo"
                                            title="Redo">

                                        <i class="bi bi-arrow-clockwise"></i>

                                    </button>

                                </div>



                                <!-- EDITOR -->

                                <div id="editorContent"
                                     class="editor-content"
                                     contenteditable="true"
                                     data-placeholder="Write your announcement here...">
                                </div>

                            </div>



                            <!-- HIDDEN MODEL FIELD -->

                            <textarea asp-for="Content"
                                      id="Content"
                                      style="display:none;">
                            </textarea>



                            <!-- CHARACTER COUNT -->

                            <div class="d-flex justify-content-between mt-1">

                                <span asp-validation-for="Content"
                                      class="text-danger">
                                </span>


                                <span class="character-count">

                                    <span id="charCount">
                                        0
                                    </span>

                                    / 5000 characters

                                </span>

                            </div>

                        </div>



                        <!-- =================================================
                             DATE
                             ================================================= -->

                        <div class="mb-4">

                            <label asp-for="DatePosted"
                                   class="form-label fw-semibold">

                                Date Posted

                            </label>


                            <input asp-for="DatePosted"
                                   type="date"
                                   class="form-control" />


                            <span asp-validation-for="DatePosted"
                                  class="text-danger">
                            </span>

                        </div>



                        <!-- =================================================
                             STATUS
                             ================================================= -->

                        <div class="mb-4">

                            <label asp-for="Status"
                                   class="form-label fw-semibold">

                                Status

                            </label>


                            <select asp-for="Status"
                                    class="form-select">

                                <option value="Published">
                                    Published
                                </option>

                                <option value="Draft">
                                    Draft
                                </option>

                            </select>


                            <span asp-validation-for="Status"
                                  class="text-danger">
                            </span>

                        </div>



                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div class="d-flex gap-2">


                            <button type="submit"
                                    class="btn btn-primary"
                                    id="submitButton">

                                <i class="bi bi-check-lg me-1"></i>

                                Publish Announcement

                            </button>


                            <a asp-controller="Announcements"
                               asp-action="Index"
                               class="btn btn-secondary"
                               id="cancelButtonBottom">

                                <i class="bi bi-x-lg me-1"></i>

                                Cancel

                            </a>

                        </div>


                    </form>

                </div>

            </div>

        </div>



        <!-- =================================================
             RIGHT SIDE
             ================================================= -->

        <div class="col-lg-4 mt-4 mt-lg-0">


            <!-- GUIDE -->

            <div class="card shadow-sm border-0">

                <div class="card-header">

                    <h5 class="mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        Announcement Guide

                    </h5>

                </div>


                <div class="card-body">


                    <div class="mb-4">

                        <h6 class="fw-bold">

                            <i class="bi bi-type me-2"></i>

                            Title

                        </h6>

                        <p class="text-muted small mb-0">

                            Use a short and clear title that tells
                            residents what the announcement is about.

                        </p>

                    </div>



                    <div class="mb-4">

                        <h6 class="fw-bold">

                            <i class="bi bi-file-text me-2"></i>

                            Content

                        </h6>

                        <p class="text-muted small mb-0">

                            Use the formatting toolbar to create
                            a clear and professional announcement.

                        </p>

                    </div>



                    <div class="mb-4">

                        <h6 class="fw-bold">

                            <i class="bi bi-calendar-event me-2"></i>

                            Date Posted

                        </h6>

                        <p class="text-muted small mb-0">

                            Select the date when the announcement
                            should be posted.

                        </p>

                    </div>



                    <div>

                        <h6 class="fw-bold">

                            <i class="bi bi-toggle-on me-2"></i>

                            Status

                        </h6>

                        <p class="text-muted small mb-0">

                            Choose <strong>Published</strong> for an
                            active announcement or
                            <strong>Draft</strong> while preparing it.

                        </p>

                    </div>

                </div>

            </div>



            <!-- REMINDER -->

            <div class="alert alert-info mt-3">

                <div class="d-flex">

                    <i class="bi bi-info-circle-fill me-2"></i>

                    <div>

                        <strong>
                            Reminder
                        </strong>

                        <br />

                        Make sure the announcement information
                        is accurate before publishing it.

                    </div>

                </div>

            </div>


        </div>

    </div>

</div>



<!-- =========================================================
     FILE INPUTS
     ========================================================= -->

<input type="file"
       id="imageUpload"
       accept="image/*"
       style="display:none;" />


<input type="file"
       id="fileUpload"
       style="display:none;" />



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        /* =====================================================
           ELEMENTS
           ===================================================== */

        const editor =
            document.getElementById("editorContent");

        const contentField =
            document.getElementById("Content");

        const charCount =
            document.getElementById("charCount");

        const form =
            document.getElementById("announcementForm");

        const submitButton =
            document.getElementById("submitButton");

        const cancelButton =
            document.getElementById("cancelButton");

        const cancelButtonBottom =
            document.getElementById("cancelButtonBottom");


        /* =====================================================
           HEADER PROGRESS ELEMENTS
           ===================================================== */

        const headerPublishProgress =
            document.getElementById(
                "headerPublishProgress"
            );

        const headerProgressBar =
            document.getElementById(
                "headerProgressBar"
            );


        /* =====================================================
           PUBLISH STATUS ELEMENTS
           ===================================================== */

        const publishStatusMessage =
            document.getElementById(
                "publishStatusMessage"
            );

        const publishStatusText =
            document.getElementById(
                "publishStatusText"
            );


        /* =====================================================
           EDITOR SELECTION
           ===================================================== */

        let savedRange = null;


        function saveSelection() {

            const selection =
                window.getSelection();


            if (!selection) {
                return;
            }


            if (selection.rangeCount > 0) {

                savedRange =
                    selection.getRangeAt(0);

            }

        }


        function restoreSelection() {

            if (!savedRange) {

                editor.focus();

                return;

            }


            const selection =
                window.getSelection();


            selection.removeAllRanges();

            selection.addRange(
                savedRange
            );

            editor.focus();

        }


        editor.addEventListener(
            "mouseup",
            saveSelection
        );


        editor.addEventListener(
            "keyup",
            saveSelection
        );


        editor.addEventListener(
            "focus",
            saveSelection
        );


        /* =====================================================
           LOAD EXISTING CONTENT
           ===================================================== */

        if (contentField.value.trim() !== "") {

            editor.innerHTML =
                contentField.value;

        }


        /* =====================================================
           FORMAT COMMAND
           ===================================================== */

        function executeCommand(
            command,
            value = null
        ) {

            restoreSelection();


            document.execCommand(
                command,
                false,
                value
            );


            editor.focus();

            updateContent();

            saveSelection();

        }


        /* =====================================================
           TOOLBAR BUTTONS
           ===================================================== */

        document
            .querySelectorAll(
                ".editor-button[data-command]"
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        "mousedown",
                        function (event) {

                            event.preventDefault();

                        }
                    );


                    button.addEventListener(
                        "click",
                        function () {

                            const command =
                                button.getAttribute(
                                    "data-command"
                                );


                            executeCommand(
                                command
                            );

                        }
                    );

                }
            );


        /* =====================================================
           FONT
           ===================================================== */

        document
            .getElementById("fontName")
            .addEventListener(
                "change",
                function () {

                    if (!this.value) {
                        return;
                    }


                    executeCommand(
                        "fontName",
                        this.value
                    );


                    this.value = "";

                }
            );


        /* =====================================================
           FONT SIZE
           ===================================================== */

        document
            .getElementById("fontSize")
            .addEventListener(
                "change",
                function () {

                    if (!this.value) {
                        return;
                    }


                    executeCommand(
                        "fontSize",
                        this.value
                    );


                    this.value = "";

                }
            );


        /* =====================================================
           LINK
           ===================================================== */

        const linkButton =
            document.getElementById(
                "linkButton"
            );


        linkButton.addEventListener(
            "mousedown",
            function (event) {

                event.preventDefault();

                saveSelection();

            }
        );


        linkButton.addEventListener(
            "click",
            function () {

                restoreSelection();


                const url =
                    prompt(
                        "Enter the website URL:",
                        "https://"
                    );


                if (!url) {
                    return;
                }


                executeCommand(
                    "createLink",
                    url
                );

            }
        );


        /* =====================================================
           IMAGE
           ===================================================== */

        const imageButton =
            document.getElementById(
                "imageButton"
            );


        const imageUpload =
            document.getElementById(
                "imageUpload"
            );


        imageButton.addEventListener(
            "mousedown",
            function (event) {

                event.preventDefault();

                saveSelection();

            }
        );


        imageButton.addEventListener(
            "click",
            function () {

                saveSelection();

                imageUpload.click();

            }
        );


        imageUpload.addEventListener(
            "change",
            function () {

                const file =
                    this.files[0];


                if (!file) {
                    return;
                }


                if (!file.type.startsWith("image/")) {

                    alert(
                        "Please select an image file."
                    );

                    return;

                }


                const reader =
                    new FileReader();


                reader.onload =
                    function (event) {

                        restoreSelection();


                        const image =
                            document.createElement(
                                "img"
                            );


                        image.src =
                            event.target.result;


                        image.alt =
                            "Announcement Image";


                        image.style.maxWidth =
                            "100%";


                        image.style.height =
                            "auto";


                        image.style.display =
                            "block";


                        image.style.margin =
                            "10px 0";


                        const selection =
                            window.getSelection();


                        if (
                            selection &&
                            selection.rangeCount > 0
                        ) {

                            const range =
                                selection.getRangeAt(
                                    0
                                );


                            range.deleteContents();


                            range.insertNode(
                                image
                            );


                            range.setStartAfter(
                                image
                            );


                            range.collapse(
                                true
                            );


                            selection.removeAllRanges();


                            selection.addRange(
                                range
                            );

                        }
                        else {

                            editor.appendChild(
                                image
                            );

                        }


                        updateContent();

                        editor.focus();

                    };


                reader.readAsDataURL(
                    file
                );


                this.value = "";

            }
        );


        /* =====================================================
           FILE
           ===================================================== */

        const fileButton =
            document.getElementById(
                "fileButton"
            );


        const fileUpload =
            document.getElementById(
                "fileUpload"
            );


        fileButton.addEventListener(
            "mousedown",
            function (event) {

                event.preventDefault();

                saveSelection();

            }
        );


        fileButton.addEventListener(
            "click",
            function () {

                saveSelection();

                fileUpload.click();

            }
        );


        fileUpload.addEventListener(
            "change",
            function () {

                const file =
                    this.files[0];


                if (!file) {
                    return;
                }


                restoreSelection();


                const fileLink =
                    document.createElement(
                        "span"
                    );


                fileLink.textContent =
                    "📎 " + file.name;


                fileLink.style.display =
                    "inline-block";


                fileLink.style.margin =
                    "5px 0";


                const selection =
                    window.getSelection();


                if (
                    selection &&
                    selection.rangeCount > 0
                ) {

                    const range =
                        selection.getRangeAt(
                            0
                        );


                    range.deleteContents();


                    range.insertNode(
                        fileLink
                    );


                    range.setStartAfter(
                        fileLink
                    );


                    range.collapse(
                        true
                    );


                    selection.removeAllRanges();


                    selection.addRange(
                        range
                    );

                }
                else {

                    editor.appendChild(
                        fileLink
                    );

                }


                updateContent();

                editor.focus();

                this.value = "";

            }
        );


        /* =====================================================
           VIDEO
           ===================================================== */

        const videoButton =
            document.getElementById(
                "videoButton"
            );


        videoButton.addEventListener(
            "mousedown",
            function (event) {

                event.preventDefault();

                saveSelection();

            }
        );


        videoButton.addEventListener(
            "click",
            function () {

                const videoUrl =
                    prompt(
                        "Enter the video URL:"
                    );


                if (!videoUrl) {
                    return;
                }


                restoreSelection();


                const video =
                    document.createElement(
                        "video"
                    );


                video.src =
                    videoUrl;


                video.controls =
                    true;


                video.style.maxWidth =
                    "100%";


                video.style.display =
                    "block";


                video.style.margin =
                    "10px 0";


                const selection =
                    window.getSelection();


                if (
                    selection &&
                    selection.rangeCount > 0
                ) {

                    const range =
                        selection.getRangeAt(
                            0
                        );


                    range.deleteContents();


                    range.insertNode(
                        video
                    );


                    range.setStartAfter(
                        video
                    );


                    range.collapse(
                        true
                    );


                    selection.removeAllRanges();


                    selection.addRange(
                        range
                    );

                }
                else {

                    editor.appendChild(
                        video
                    );

                }


                updateContent();

                editor.focus();

            }
        );


        /* =====================================================
           VOICE INPUT
           ===================================================== */

        const voiceButton =
            document.getElementById(
                "voiceButton"
            );


        voiceButton.addEventListener(
            "mousedown",
            function (event) {

                event.preventDefault();

                saveSelection();

            }
        );


        voiceButton.addEventListener(
            "click",
            function () {

                startVoiceInput();

            }
        );


        function startVoiceInput() {

            const SpeechRecognition =
                window.SpeechRecognition ||
                window.webkitSpeechRecognition;


            if (!SpeechRecognition) {

                alert(
                    "Voice input is not supported by this browser."
                );

                return;

            }


            const recognition =
                new SpeechRecognition();


            recognition.lang =
                "en-US";


            recognition.interimResults =
                false;


            recognition.continuous =
                false;


            recognition.onstart =
                function () {

                    voiceButton.classList.add(
                        "active"
                    );

                };


            recognition.onend =
                function () {

                    voiceButton.classList.remove(
                        "active"
                    );

                };


            recognition.onerror =
                function () {

                    voiceButton.classList.remove(
                        "active"
                    );

                    alert(
                        "Unable to use voice input."
                    );

                };


            recognition.onresult =
                function (event) {

                    const spokenText =
                        event.results[0][0]
                            .transcript;


                    restoreSelection();


                    document.execCommand(
                        "insertText",
                        false,
                        spokenText
                    );


                    updateContent();

                    saveSelection();

                };


            recognition.start();

        }


        /* =====================================================
           UPDATE CONTENT
           ===================================================== */

        function updateContent() {

            contentField.value =
                editor.innerHTML;


            updateCharacterCount();

        }


        /* =====================================================
           CHARACTER COUNT
           ===================================================== */

        function updateCharacterCount() {

            const text =
                editor.innerText || "";


            charCount.textContent =
                text.length;


            if (text.length > 5000) {

                charCount.style.color =
                    "#dc3545";

            }
            else {

                charCount.style.color =
                    "#6c757d";

            }

        }


        editor.addEventListener(
            "input",
            updateContent
        );


        /* =====================================================
           KEYBOARD SHORTCUTS
           ===================================================== */

        editor.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.ctrlKey &&
                    event.key.toLowerCase() === "b"
                ) {

                    event.preventDefault();

                    executeCommand(
                        "bold"
                    );

                }


                if (
                    event.ctrlKey &&
                    event.key.toLowerCase() === "i"
                ) {

                    event.preventDefault();

                    executeCommand(
                        "italic"
                    );

                }


                if (
                    event.ctrlKey &&
                    event.key.toLowerCase() === "u"
                ) {

                    event.preventDefault();

                    executeCommand(
                        "underline"
                    );

                }

            }
        );


        /* =====================================================
           HEADER PROGRESS
           ===================================================== */

        let progressValue = 0;

        let progressTimer = null;


        /* =====================================================
           SET PROGRESS
           ===================================================== */

        function setProgress(value) {

            progressValue =
                Math.min(
                    Math.max(value, 0),
                    100
                );


            headerProgressBar.style.width =
                progressValue + "%";


            headerProgressBar.setAttribute(
                "aria-valuenow",
                Math.round(progressValue)
            );

        }


        /* =====================================================
           START PUBLISHING PROGRESS
           ===================================================== */

        function startPublishingProgress() {

            /*
             * Reset progress
             */

            progressValue = 0;


            setProgress(5);


            /*
             * Show top progress bar
             */

            headerPublishProgress.classList.add(
                "show"
            );


            /*
             * Show status message
             */

            publishStatusMessage.classList.add(
                "show"
            );


            publishStatusText.textContent =
                "Preparing announcement...";


            /*
             * Clear any old timer
             */

            if (progressTimer !== null) {

                clearInterval(
                    progressTimer
                );

            }


            /*
             * Slowly move toward 90%.
             *
             * IMPORTANT:
             * We intentionally DO NOT reach 100%.
             *
             * 100% will only happen after
             * the server successfully saves.
             */

            progressTimer =
                setInterval(
                    function () {

                        if (progressValue < 20) {

                            setProgress(
                                progressValue + 1
                            );

                        }

                        else if (
                            progressValue < 50
                        ) {

                            setProgress(
                                progressValue + 0.7
                            );

                        }

                        else if (
                            progressValue < 70
                        ) {

                            setProgress(
                                progressValue + 0.4
                            );

                        }

                        else if (
                            progressValue < 82
                        ) {

                            setProgress(
                                progressValue + 0.2
                            );

                        }

                        else if (
                            progressValue < 90
                        ) {

                            setProgress(
                                progressValue + 0.1
                            );

                        }

                    },
                    1000
                );


            /*
             * Status messages
             */

            setTimeout(
                function () {

                    publishStatusText.textContent =
                        "Uploading announcement...";

                },
                1000
            );


            setTimeout(
                function () {

                    publishStatusText.textContent =
                        "Processing announcement...";

                },
                2000
            );


            setTimeout(
                function () {

                    publishStatusText.textContent =
                        "Saving to database...";

                },
                3000
            );


            setTimeout(
                function () {

                    publishStatusText.textContent =
                        "Almost finished...";

                },
                4500
            );


            setTimeout(
                function () {

                    publishStatusText.textContent =
                        "Finalizing announcement...";

                },
                6000
            );

        }


        /* =====================================================
           FORM SUBMIT
           ===================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                /*
                 * Update hidden Content field
                 */

                updateContent();


                /*
                 * Get plain text
                 */

                const text =
                    editor.innerText.trim();


                /* =================================================
                   EMPTY CONTENT
                   ================================================= */

                if (text.length === 0) {

                    event.preventDefault();


                    alert(
                        "Please enter announcement content."
                    );


                    editor.focus();

                    return;

                }


                /* =================================================
                   MAXIMUM CHARACTERS
                   ================================================= */

                if (text.length > 5000) {

                    event.preventDefault();


                    alert(
                        "Announcement content cannot exceed 5000 characters."
                    );


                    editor.focus();

                    return;

                }


                /* =================================================
                   EMPTY TITLE
                   ================================================= */

                const titleInput =
                    document.getElementById(
                        "Title"
                    );


                if (
                    titleInput &&
                    titleInput.value.trim() === ""
                ) {

                    event.preventDefault();


                    alert(
                        "Please enter an announcement title."
                    );


                    titleInput.focus();

                    return;

                }


                /* =================================================
                   DISABLE PUBLISH BUTTON
                   ================================================= */

                submitButton.disabled =
                    true;


                /* =================================================
                   DISABLE TOP CANCEL
                   ================================================= */

                cancelButton.style.pointerEvents =
                    "none";

                cancelButton.style.opacity =
                    "0.5";


                /* =================================================
                   DISABLE BOTTOM CANCEL
                   ================================================= */

                cancelButtonBottom.style.pointerEvents =
                    "none";

                cancelButtonBottom.style.opacity =
                    "0.5";


                /* =================================================
                   CHANGE BUTTON
                   ================================================= */

                submitButton.innerHTML =

                    '<span class="spinner-border spinner-border-sm me-2" ' +
                    'role="status" aria-hidden="true"></span>' +

                    'Publishing...';


                /* =================================================
                   START HEADER PROGRESS
                   ================================================= */

                startPublishingProgress();


                /*
                 * IMPORTANT:
                 *
                 * We DO NOT call:
                 *
                 * event.preventDefault();
                 *
                 * here.
                 *
                 * The normal MVC form submission
                 * will continue to the controller.
                 */

            }
        );


        /* =====================================================
           INITIALIZE
           ===================================================== */

        updateContent();

    </script>

}