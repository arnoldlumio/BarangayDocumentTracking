             aria-valuemin="0"
             aria-valuemax="100"
             style="width: 0%;">
        </div>

    </div>




    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="mb-1">

                <i class="bi bi-megaphone me-2"></i>

                Create Announcement

            </h4>

            <p class="text-muted mb-0">

                Create a new announcement for barangay residents.

            </p>

        </div>


        <a asp-controller="Announcements"
