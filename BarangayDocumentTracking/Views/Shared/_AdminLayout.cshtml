@{
    var username = Context.Session.GetString("Username") ?? "User";
    var role = Context.Session.GetString("Role") ?? "Administrator";

    // Get current controller and action
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Barangay Document Tracking
    </title>


    <!-- ==========================================
         BOOTSWATCH FLATLY
         ========================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css">


    <!-- ==========================================
         BOOTSTRAP ICONS
         ========================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <style>

        /* ==========================================
           GENERAL
           ========================================== */

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }


        body {

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

            background: #f5f7fa;

            color: #2c3e50;
        }



        /* ==========================================
           SIDEBAR
           ========================================== */

        .sidebar {

            position: fixed;

            top: 0;
            left: 0;

            width: 250px;

            height: 100vh;

            background: #343a40;

            border-right: 1px solid #495057;

            z-index: 1000;

            display: flex;

            flex-direction: column;

            transition: transform 0.25s ease;
        }



        /* ==========================================
           SIDEBAR BRAND
           ========================================== */

        .sidebar-brand {

            height: 75px;

            padding: 12px 20px;

            display: flex;

            align-items: center;

            border-bottom: 1px solid #495057;

            flex-shrink: 0;
        }


        .sidebar-logo {

            width: 48px;

            height: 48px;

            object-fit: contain;

            margin-right: 12px;

            flex-shrink: 0;
        }


        .brand-text {

            min-width: 0;
        }


        .brand-title {

            margin: 0;

            font-size: 15px;

            font-weight: 700;

            color: #ffffff;

            line-height: 1.2;
        }


        .brand-subtitle {

            margin: 3px 0 0;

            font-size: 10px;

            color: #adb5bd;
        }



        /* ==========================================
           SIDEBAR NAVIGATION
           ========================================== */

        .sidebar-nav {

            flex: 1;

            padding: 20px 12px;

            overflow-y: auto;
        }


        /* Custom scrollbar */

        .sidebar-nav::-webkit-scrollbar {

            width: 5px;
        }


        .sidebar-nav::-webkit-scrollbar-track {

            background: #343a40;
        }


        .sidebar-nav::-webkit-scrollbar-thumb {

            background: #5a6268;

            border-radius: 10px;
        }



        /* ==========================================
           NAVIGATION SECTION
           ========================================== */

        .nav-section {

            font-size: 10px;

            font-weight: 700;

            color: #adb5bd;

            text-transform: uppercase;

            letter-spacing: 0.7px;

            padding: 0 12px;

            margin-bottom: 8px;

            margin-top: 10px;
        }



        /* ==========================================
           NAVIGATION ITEM
           ========================================== */

        .nav-item {

            margin-bottom: 4px;
        }


        .nav-link-custom {

            display: flex;

            align-items: center;

            width: 100%;

            padding: 11px 12px;

            border-radius: 6px;

            color: #dee2e6;

            text-decoration: none;

            font-size: 13px;

            font-weight: 500;

            transition:
                background 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }


        .nav-link-custom i {

            width: 25px;

            font-size: 17px;

            margin-right: 9px;

            text-align: center;

            flex-shrink: 0;
        }


        /* ==========================================
           NAVIGATION HOVER
           ========================================== */

        .nav-link-custom:hover {

            background: #454d55;

            color: #ffffff;

            text-decoration: none;
        }


        /* ==========================================
           ACTIVE MENU
           FLATLY BLUE
           ========================================== */

        .nav-link-custom.active {

            background: #3498db;

            color: #ffffff;

            box-shadow:
                0 3px 8px rgba(0, 0, 0, 0.15);
        }


        .nav-link-custom.active:hover {

            background: #3498db;

            color: #ffffff;
        }



        /* ==========================================
           SIDEBAR FOOTER
           ========================================== */

        .sidebar-footer {

            padding: 15px;

            border-top: 1px solid #495057;

            flex-shrink: 0;
        }


        /* ==========================================
           USER INFORMATION
           ========================================== */

        .user-info {

            display: flex;

            align-items: center;

            padding: 8px;
        }


        .user-avatar {

            width: 38px;

            height: 38px;

            border-radius: 50%;

            background: #3498db;

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 16px;

            margin-right: 10px;

            flex-shrink: 0;
        }


        .user-details {

            flex: 1;

            min-width: 0;
        }


        .user-name {

            font-size: 13px;

            font-weight: 600;

            color: #ffffff;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        .user-role {

            font-size: 10px;

            color: #adb5bd;

            margin-top: 2px;
        }



        /* ==========================================
           MAIN WRAPPER
           ========================================== */

        .main-wrapper {

            margin-left: 250px;

            min-height: 100vh;

            transition: margin-left 0.25s ease;
        }



        /* ==========================================
           TOP NAVBAR
           ========================================== */

        .top-navbar {

            height: 75px;

            background: #ffffff;

            border-bottom: 1px solid #e5e9ed;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 30px;

            position: sticky;

            top: 0;

            z-index: 900;
        }


        .navbar-left {

            display: flex;

            align-items: center;
        }


        .page-title {

            margin: 0;

            font-size: 18px;

            font-weight: 600;

            color: #2c3e50;
        }


        /* ==========================================
           MOBILE MENU BUTTON
           ========================================== */

        .mobile-menu-btn {

            display: none;

            width: 40px;

            height: 40px;

            border: none;

            background: transparent;

            font-size: 22px;

            color: #2c3e50;

            align-items: center;

            justify-content: center;

            margin-right: 10px;

            border-radius: 5px;
        }


        .mobile-menu-btn:hover {

            background: #f5f7fa;

            color: #3498db;
        }



        /* ==========================================
           NAVBAR RIGHT
           ========================================== */

        .navbar-right {

            display: flex;

            align-items: center;

            gap: 15px;
        }



        /* ==========================================
           NOTIFICATION
           ========================================== */

        .notification-btn {

            width: 38px;

            height: 38px;

            border-radius: 50%;

            border: none;

            background: #f5f7fa;

            color: #52616b;

            display: flex;

            align-items: center;

            justify-content: center;

            position: relative;

            cursor: pointer;
        }


        .notification-btn:hover {

            background: #eaf2f8;

            color: #3498db;
        }


        .notification-dot {

            position: absolute;

            top: 7px;

            right: 7px;

            width: 7px;

            height: 7px;

            background: #e74c3c;

            border-radius: 50%;

            border: 1px solid #ffffff;
        }



        /* ==========================================
           CONTENT
           ========================================== */

        .content {

            padding: 30px;
        }



        /* ==========================================
           DASHBOARD CARDS
           ========================================== */

        .dashboard-card {

            background: #ffffff;

            border: 1px solid #e5e9ed;

            border-radius: 8px;

            padding: 20px;

            height: 100%;

            box-shadow:
                0 2px 8px rgba(0, 0, 0, 0.04);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .dashboard-card:hover {

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(0, 0, 0, 0.08);
        }


        .card-icon {

            width: 48px;

            height: 48px;

            border-radius: 8px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 21px;

            margin-bottom: 15px;
        }


        .card-icon-blue {

            background: #eaf4fb;

            color: #3498db;
        }


        .card-icon-green {

            background: #eaf7f0;

            color: #27ae60;
        }


        .card-icon-orange {

            background: #fff4e6;

            color: #f39c12;
        }


        .card-icon-red {

            background: #fceeee;

            color: #e74c3c;
        }


        .card-label {

            font-size: 12px;

            color: #7f8c8d;

            margin-bottom: 5px;
        }


        .card-number {

            font-size: 27px;

            font-weight: 700;

            color: #2c3e50;

            margin: 0;
        }



        /* ==========================================
           GENERAL CONTENT CARD
           ========================================== */

        .content-card {

            background: #ffffff;

            border: 1px solid #e5e9ed;

            border-radius: 8px;

            box-shadow:
                0 2px 8px rgba(0, 0, 0, 0.04);

            overflow: hidden;
        }


        .content-card-header {

            padding: 18px 20px;

            border-bottom: 1px solid #e5e9ed;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .content-card-title {

            margin: 0;

            font-size: 15px;

            font-weight: 600;

            color: #2c3e50;
        }


        .content-card-body {

            padding: 20px;
        }



        /* ==========================================
           TABLE
           ========================================== */

        .table {

            margin-bottom: 0;
        }


        .table thead th {

            font-size: 11px;

            font-weight: 700;

            color: #7f8c8d;

            text-transform: uppercase;

            letter-spacing: 0.3px;

            border-bottom-width: 1px;
        }


        .table tbody td {

            font-size: 13px;

            color: #52616b;

            vertical-align: middle;
        }



        /* ==========================================
           SIDEBAR OVERLAY
           ========================================== */

        .sidebar-overlay {

            display: none;

            position: fixed;

            inset: 0;

            background: rgba(0, 0, 0, 0.40);

            z-index: 999;
        }



        /* ==========================================
           RESPONSIVE
           ========================================== */

        @@media (max-width: 768px) {

            .sidebar {

                transform: translateX(-100%);
            }


            .sidebar.show {

                transform: translateX(0);
            }


            .sidebar-overlay.show {

                display: block;
            }


            .main-wrapper {

                margin-left: 0;
            }


            .mobile-menu-btn {

                display: flex;
            }


            .top-navbar {

                padding: 0 15px;
            }


            .content {

                padding: 20px 15px;
            }


            .page-title {

                font-size: 16px;
            }

        }



        /* ==========================================
           SMALL MOBILE
           ========================================== */

        @@media (max-width: 480px) {

            .content {

                padding: 15px 10px;
            }


            .navbar-right {

                gap: 5px;
            }

        }



        /* ==========================================
   NOTIFICATION WRAPPER
   ========================================== */

.notification-wrapper {
    position: relative;
}


/* ==========================================
   NOTIFICATION DROPDOWN
   ========================================== */

.notification-dropdown {
    position: absolute;

    top: 48px;
    right: 0;

    width: 370px;

    background: #ffffff;

    border: 1px solid #e5e9ed;

    border-radius: 8px;

    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);

    overflow: hidden;

    display: none;

    z-index: 2000;
}


/* SHOW DROPDOWN */

.notification-dropdown.show {
    display: block;
}


/* ==========================================
   DROPDOWN HEADER
   ========================================== */

.notification-dropdown-header {
    padding: 15px 17px;

    border-bottom: 1px solid #e5e9ed;

    display: flex;

    align-items: center;

    justify-content: space-between;
}


.notification-dropdown-header h6 {
    margin: 0;

    color: #2c3e50;

    font-size: 14px;

    font-weight: 600;
}


.notification-dropdown-header small {
    display: block;

    margin-top: 3px;

    color: #95a5a6;

    font-size: 11px;
}


.notification-new-badge {
    background: #3498db;

    color: #ffffff;

    padding: 4px 9px;

    border-radius: 15px;

    font-size: 10px;

    font-weight: 600;
}


/* ==========================================
   DROPDOWN ITEM
   ========================================== */

.notification-dropdown-item {
    display: flex;

    align-items: flex-start;

    padding: 14px 17px;

    color: #2c3e50;

    text-decoration: none;

    border-bottom: 1px solid #edf0f2;

    transition: background 0.2s ease;
}


.notification-dropdown-item:hover {
    background: #f7f9fb;

    color: #2c3e50;
}


.notification-dropdown-item.unread {
    background: #f7fbff;
}


/* ==========================================
   DROPDOWN ICON
   ========================================== */

.dropdown-notification-icon {
    width: 36px;

    height: 36px;

    border-radius: 7px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 15px;

    margin-right: 11px;

    flex-shrink: 0;
}


.dropdown-notification-icon.blue {
    background: #eaf4fb;

    color: #3498db;
}


.dropdown-notification-icon.orange {
    background: #fff4e6;

    color: #f39c12;
}


.dropdown-notification-icon.green {
    background: #eaf7f0;

    color: #27ae60;
}


.dropdown-notification-icon.purple {
    background: #f2edfa;

    color: #6f42c1;
}


/* ==========================================
   DROPDOWN CONTENT
   ========================================== */

.dropdown-notification-content {
    flex: 1;

    min-width: 0;
}


.dropdown-notification-content strong {
    display: block;

    color: #2c3e50;

    font-size: 12px;

    font-weight: 600;

    margin-bottom: 3px;
}


.dropdown-notification-content p {
    margin: 0 0 4px;

    color: #7f8c8d;

    font-size: 11px;

    line-height: 1.4;
}


.dropdown-notification-content small {
    color: #adb5bd;

    font-size: 10px;
}


/* ==========================================
   DROPDOWN FOOTER
   ========================================== */

.notification-dropdown-footer {
    padding: 12px;

    text-align: center;

    background: #ffffff;
}


.notification-dropdown-footer a {
    color: #3498db;

    text-decoration: none;

    font-size: 12px;

    font-weight: 600;
}


.notification-dropdown-footer a:hover {
    color: #217dbb;

    text-decoration: underline;
}


/* ==========================================
   MOBILE
   ========================================== */

@@media (max-width: 576px) {

    .notification-dropdown {
        position: fixed;

        top: 70px;

        left: 10px;

        right: 10px;

        width: auto;

        max-width: none;
    }

}

    </style>


    @RenderSection("Styles", required: false)

</head>


<body>


    <!-- ==========================================
         SIDEBAR
         ========================================== -->

    <aside class="sidebar"
           id="sidebar">


        <!-- ======================================
             SIDEBAR BRAND
             ====================================== -->

        <div class="sidebar-brand">

            <img src="~/img/barangay_logo.png"
                 alt="Barangay Logo"
                 class="sidebar-logo" />


            <div class="brand-text">

                <h5 class="brand-title">

                    Barangay Document

                </h5>


                <p class="brand-subtitle">

                    Tracking System

                </p>

            </div>

        </div>



        <!-- ======================================
             SIDEBAR NAVIGATION
             ====================================== -->

        <div class="sidebar-nav">


            <!-- MAIN -->

            <div class="nav-section">

                Main

            </div>


            <!-- DASHBOARD -->

            <div class="nav-item">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Dashboard" ? "active" : "")">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

            </div>



            <!-- DOCUMENTS -->

            <div class="nav-section">

                Documents

            </div>


            <!-- ALL DOCUMENTS -->

            <div class="nav-item">

                <a asp-controller="Documents"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Documents" ? "active" : "")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        All Documents
                    </span>

                </a>

            </div>


            <!-- INCOMING DOCUMENTS -->

            <div class="nav-item">

                <a asp-controller="Incoming"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Incoming" ? "active" : "")">

                    <i class="bi bi-box-arrow-in-down"></i>

                    <span>
                        Incoming Documents
                    </span>

                </a>

            </div>


            <!-- OUTGOING DOCUMENTS -->

            <div class="nav-item">

                <a asp-controller="Outgoing"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Outgoing" ? "active" : "")">

                    <i class="bi bi-box-arrow-up"></i>

                    <span>
                        Outgoing Documents
                    </span>

                </a>

            </div>



            <!-- MONITORING -->

            <div class="nav-section">

                Monitoring

            </div>


            <!-- DOCUMENT TRACKING -->

            <div class="nav-item">

                <a asp-controller="Tracking"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Tracking" ? "active" : "")">

                    <i class="bi bi-search"></i>

                    <span>
                        Document Tracking
                    </span>

                </a>

            </div>


            <!-- REPORTS -->

            <div class="nav-item">

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Reports" ? "active" : "")">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        Reports
                    </span>

                </a>

            </div>


            <div class="nav-item">

            <a asp-controller="Announcements"
               asp-action="Index"
               class="nav-link-custom @(currentController == "Announcements" ? "active" : "")">

                <i class="bi bi-megaphone"></i>

                <span>
                    Announcements
                </span>

            </a>

        </div>



            <!-- ADMINISTRATION -->

            <div class="nav-section">

                Administration

            </div>


            <!-- USERS -->

            <div class="nav-item">

                <a asp-controller="Users"
                   asp-action="Index"
                   class="nav-link-custom @(currentController == "Users" ? "active" : "")">

                    <i class="bi bi-people"></i>

                    <span>
                        Users
                    </span>

                </a>

            </div>

        </div>



        <!-- ======================================
             SIDEBAR FOOTER
             ====================================== -->

        <div class="sidebar-footer">


            <!-- USER -->

            <div class="user-info">


                <div class="user-avatar">

                    <i class="bi bi-person"></i>

                </div>


                <div class="user-details">

                    <div class="user-name">

                        @username

                    </div>


                    <div class="user-role">

                        @role

                    </div>

                </div>

            </div>



            <!-- LOGOUT -->

            <a asp-controller="Account"
               asp-action="Logout"
               class="nav-link-custom mt-2">

                <i class="bi bi-box-arrow-right"></i>

                <span>
                    Logout
                </span>

            </a>

        </div>

    </aside>



    <!-- ==========================================
         SIDEBAR OVERLAY
         ========================================== -->

    <div class="sidebar-overlay"
         id="sidebarOverlay">
    </div>



    <!-- ==========================================
         MAIN WRAPPER
         ========================================== -->

    <div class="main-wrapper">


        <!-- ======================================
             TOP NAVBAR
             ====================================== -->

        <header class="top-navbar">


            <!-- LEFT -->

            <div class="navbar-left">


                <!-- MOBILE MENU -->

                <button type="button"
                        class="mobile-menu-btn"
                        id="mobileMenuBtn"
                        aria-label="Open menu">

                    <i class="bi bi-list"></i>

                </button>


                <!-- PAGE TITLE -->

                <h1 class="page-title">

                    @ViewData["Title"]

                </h1>

            </div>



            <!-- RIGHT -->

            <div class="navbar-right">


                <!-- NOTIFICATION -->

                <!-- NOTIFICATION DROPDOWN -->
<div class="notification-wrapper">

    <button type="button"
            class="notification-btn"
            id="notificationButton"
            title="Notifications">

        <i class="bi bi-bell"></i>

        <span class="notification-dot"></span>

    </button>


    <!-- DROPDOWN -->
    <div class="notification-dropdown"
         id="notificationDropdown">

        <!-- HEADER -->
        <div class="notification-dropdown-header">

            <div>
                <h6>
                    Notifications
                </h6>

                <small>
                    4 new notifications
                </small>
            </div>

            <span class="notification-new-badge">
                New
            </span>

        </div>


        <!-- NOTIFICATION 1 -->
        <a href="#"
           class="notification-dropdown-item unread">

            <div class="dropdown-notification-icon blue">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div class="dropdown-notification-content">

                <strong>
                    New Document Received
                </strong>

                <p>
                    DOC-006 has been received and is waiting for processing.
                </p>

                <small>
                    10 minutes ago
                </small>

            </div>

        </a>


        <!-- NOTIFICATION 2 -->
        <a href="#"
           class="notification-dropdown-item unread">

            <div class="dropdown-notification-icon orange">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div class="dropdown-notification-content">

                <strong>
                    Document Processing
                </strong>

                <p>
                    DOC-002 is currently being processed.
                </p>

                <small>
                    25 minutes ago
                </small>

            </div>

        </a>


        <!-- NOTIFICATION 3 -->
        <a href="#"
           class="notification-dropdown-item">

            <div class="dropdown-notification-icon green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="dropdown-notification-content">

                <strong>
                    Document Completed
                </strong>

                <p>
                    DOC-004 has been completed successfully.
                </p>

                <small>
                    1 hour ago
                </small>

            </div>

        </a>


        <!-- NOTIFICATION 4 -->
        <a href="#"
           class="notification-dropdown-item">

            <div class="dropdown-notification-icon purple">
                <i class="bi bi-arrow-up-right-square"></i>
            </div>

            <div class="dropdown-notification-content">

                <strong>
                    Document Released
                </strong>

                <p>
                    DOC-005 has been released to the recipient.
                </p>

                <small>
                    2 hours ago
                </small>

            </div>

        </a>


        <!-- FOOTER -->
        <div class="notification-dropdown-footer">

            <a asp-controller="Notification"
               asp-action="Index">

                View All Notifications
                <i class="bi bi-arrow-right ms-1"></i>

            </a>

        </div>

    </div>

</div>















                <!-- USER -->

                <div class="d-none d-md-flex align-items-center">

                    <i class="bi bi-person-circle fs-4 text-secondary me-2"></i>

                    <span class="small fw-semibold">

                        @username

                    </span>

                </div>

            </div>

        </header>



        <!-- ======================================
             PAGE CONTENT
             ====================================== -->

        <main class="content">

            @RenderBody()

        </main>


    </div>



    <!-- ==========================================
         BOOTSTRAP JAVASCRIPT
         ========================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>



    <!-- ==========================================
         SIDEBAR JAVASCRIPT
         ========================================== -->

    <script>

        const sidebar =
            document.getElementById("sidebar");

        const overlay =
            document.getElementById("sidebarOverlay");

        const menuButton =
            document.getElementById("mobileMenuBtn");


        // Open / close sidebar

        menuButton.addEventListener("click", function () {

            sidebar.classList.toggle("show");

            overlay.classList.toggle("show");

        });


        // Close sidebar when clicking overlay

        overlay.addEventListener("click", function () {

            sidebar.classList.remove("show");

            overlay.classList.remove("show");

        });


        // Close sidebar when clicking a menu on mobile

        const menuLinks =
            document.querySelectorAll(".nav-link-custom");


        menuLinks.forEach(function (link) {

            link.addEventListener("click", function () {

                if (window.innerWidth <= 768) {

                    sidebar.classList.remove("show");

                    overlay.classList.remove("show");

                }

            });

        });





        /* ==========================================
   NOTIFICATION DROPDOWN
   ========================================== */

const notificationButton =
    document.getElementById("notificationButton");

const notificationDropdown =
    document.getElementById("notificationDropdown");


/* Open / Close Notification */

notificationButton.addEventListener("click", function (event) {

    event.stopPropagation();

    notificationDropdown.classList.toggle("show");

});


/* Prevent dropdown click from closing */

notificationDropdown.addEventListener("click", function (event) {

    event.stopPropagation();

});


/* Close when clicking outside */

document.addEventListener("click", function () {

    notificationDropdown.classList.remove("show");

});

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>