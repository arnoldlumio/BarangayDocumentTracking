<!-- ==========================================
     TRACKING HISTORY MODAL
     ========================================== -->

<div class="modal fade"
     id="trackingHistoryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- HEADER -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title"
                        id="historyTitle">

                        Document Tracking History

                    </h5>

                    <div class="history-document-number"
                         id="historyDocumentNumber">

                        DOC-001

                    </div>

                </div>


                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <!-- BODY -->

            <div class="modal-body">


                <!-- DOCUMENT INFO -->

                <div class="history-info">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="history-info-label">
                                Document
                            </div>

                            <div class="history-info-value"
                                 id="historyDocumentName">

                                Barangay Resolution

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="history-info-label">
                                Current Handler
                            </div>

                            <div class="history-info-value">

                                Barangay Secretary

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="history-info-label">
                                Current Status
                            </div>

                            <div class="history-info-value">

                                <span class="badge bg-warning text-dark">

                                    Processing

                                </span>

                            </div>

                        </div>

                    </div>

                </div>



                <!-- TIMELINE -->

                <h6 class="fw-bold mb-3">

                    Movement History

                </h6>


                <div class="history-timeline">


                    <!-- STEP 1 -->

                    <div class="history-item">

                        <div class="history-icon history-completed">

                            <i class="bi bi-check"></i>

                        </div>


                        <div class="history-title">

                            Document Registered

                        </div>


                        <div class="history-date">

                            September 15, 2026 • 8:30 AM

                        </div>


                        <p class="history-description">

                            Document was registered by the administrator
                            and added to the document tracking system.

                        </p>

                    </div>



                    <!-- STEP 2 -->

                    <div class="history-item">

                        <div class="history-icon history-received">

                            <i class="bi bi-box-arrow-in-down"></i>

                        </div>


                        <div class="history-title">

                            Document Received

                        </div>


                        <div class="history-date">

                            September 15, 2026 • 9:15 AM

                        </div>


                        <p class="history-description">

                            Document was received by the Barangay Office.

                        </p>

                    </div>



                    <!-- STEP 3 -->

                    <div class="history-item">

                        <div class="history-icon history-processing">

                            <i class="bi bi-clock"></i>

                        </div>


                        <div class="history-title">

                            Processing

                        </div>


                        <div class="history-date">

                            September 15, 2026 • 10:00 AM

                        </div>


                        <p class="history-description">

                            Document is currently being reviewed
                            by the assigned personnel.

                        </p>

                    </div>



