     ========================================== -->

<script>

    /* ==========================================
       FILTER DOCUMENTS
       ========================================== */

    function filterDocuments() {

        const search =
            document.getElementById("searchDocument")
                .value
                .toLowerCase();

        const status =
            document.getElementById("statusFilter")
                .value;

        const type =
            document.getElementById("typeFilter")
                .value;

        const rows =
            document.querySelectorAll(
                "#documentTable tbody tr"
            );


        rows.forEach(function (row) {

            const documentText =
                row.innerText.toLowerCase();

            const rowStatus =
                row.getAttribute("data-status");

            const rowType =
                row.getAttribute("data-type");


            const searchMatch =
                documentText.includes(search);

            const statusMatch =
                status === "" ||
                rowStatus === status;

            const typeMatch =
                type === "" ||
                rowType === type;


            if (
                searchMatch &&
                statusMatch &&
                typeMatch
            ) {

                row.style.display = "";

            }
            else {

                row.style.display = "none";

            }

        });

    }



    /* ==========================================
       RESET FILTERS
       ========================================== */

    function resetFilters() {

        document.getElementById("searchDocument").value = "";

        document.getElementById("statusFilter").value = "";

        document.getElementById("typeFilter").value = "";

        filterDocuments();

    }



    /* ==========================================
       SHOW TRACKING HISTORY
       ========================================== */

    function showHistory(
        documentNumber,
        documentName
    ) {

        document.getElementById(
            "historyTitle"
        ).innerText =
            documentName;


        document.getElementById(
            "historyDocumentNumber"
        ).innerText =
            "Document No. " + documentNumber;


        document.getElementById(
            "historyDocumentName"
        ).innerText =
            documentName;


        const modalElement =
            document.getElementById(
                "trackingHistoryModal"
            );


        const modal =
            new bootstrap.Modal(
                modalElement
            );


        modal.show();

    }



    /* ==========================================
       INITIALIZE
       ========================================== */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            filterDocuments();

        }
    );

</script>