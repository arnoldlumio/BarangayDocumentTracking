@{
    ViewData["Title"] = "Document Tracking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ==========================================
     DOCUMENT TRACKING - ADMIN
     ========================================== -->

<style>

    /* ==========================================
           PAGE HEADER
           ========================================== */

    .tracking-header {
        margin-bottom: 25px;
    }

        .tracking-header h4 {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .tracking-header p {
            color: #7f8c8d;
            margin-bottom: 0;
        }



    /* ==========================================
           SUMMARY CARDS
           ========================================== */

    .tracking-summary-card {
        background: #ffffff;
        border: 1px solid #e5e9ed;
        border-radius: 8px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 12px;
    }

    .summary-icon-blue {
        background: #eaf4fb;
        color: #3498db;
    }

    .summary-icon-orange {
        background: #fff4e6;
        color: #f39c12;
    }

    .summary-icon-gray {
        background: #eef0f2;
        color: #7f8c8d;
    }

    .summary-icon-green {
        background: #e8f8f4;
        color: #18bc9c;
    }

    .summary-number {
        font-size: 24px;
        font-weight: 700;
        color: #2c3e50;
        margin: 0;
    }

    .summary-label {
        font-size: 12px;
        color: #7f8c8d;
        margin-top: 3px;
    }



    /* ==========================================
           FILTER CARD
           ========================================== */

    .filter-card {
        background: #ffffff;
        border: 1px solid #e5e9ed;
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .filter-title {
        font-size: 15px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 15px;
    }

    .filter-label {
        font-size: 12px;
        font-weight: 600;
        color: #7f8c8d;
        margin-bottom: 6px;
    }

    .filter-control {
        height: 42px;
        font-size: 13px;
        border-color: #dce1e5;
    }

        .filter-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.15);
        }



    /* ==========================================
           DOCUMENT TABLE CARD
           ========================================== */

    .document-table-card {
        background: #ffffff;
        border: 1px solid #e5e9ed;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .document-table-header {
        padding: 18px 20px;
        border-bottom: 1px solid #e5e9ed;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .document-table-title {
        font-size: 15px;
        font-weight: 600;
        color: #2c3e50;
        margin: 0;
    }

    .document-table-subtitle {
        font-size: 12px;
        color: #95a5a6;
        margin-top: 3px;
    }



    /* ==========================================
           TABLE
           ========================================== */

    .tracking-table {
        margin-bottom: 0;
    }

        .tracking-table thead th {
            background: #f8f9fa;
            color: #7f8c8d;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 700;
            border-bottom: 1px solid #e5e9ed;
            white-space: nowrap;
        }

        .tracking-table tbody td {
            font-size: 13px;
            color: #2c3e50;
            padding-top: 15px;
            padding-bottom: 15px;
            border-color: #eef0f2;
            vertical-align: middle;
        }

        .tracking-table tbody tr:hover {
            background: #f9fbfc;
        }

    .document-no {
        font-weight: 700;
        color: #3498db;
    }

    .document-name {
        font-weight: 600;
        color: #2c3e50;
    }

    .document-type {
        color: #7f8c8d;
        font-size: 12px;
    }



    /* ==========================================
           STATUS BADGES
           ========================================== */

    .tracking-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-processing {
        background: #fff4e6;
        color: #f39c12;
    }

    .status-pending {
        background: #eef0f2;
        color: #6c757d;
    }

    .status-approval {
        background: #eaf4fb;
        color: #3498db;
    }

    .status-completed {
        background: #e8f8f4;
        color: #18bc9c;
    }

    .status-released {
        background: #eaf4fb;
        color: #3498db;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }



    /* ==========================================
           PRIORITY
           ========================================== */

    .priority-normal {
        color: #7f8c8d;
    }

    .priority-high {
        color: #e67e22;
        font-weight: 600;
    }

    .priority-urgent {
        color: #e74c3c;
        font-weight: 700;
    }



    /* ==========================================
           ACTION BUTTON
           ========================================== */

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        padding: 0;
    }



    /* ==========================================
           MODAL
           ========================================== */

    .modal-header {
        background: #2c3e50;
        color: #ffffff;
    }

    .modal-title {
        font-size: 16px;
        font-weight: 600;
    }

    .history-document-number {
        font-size: 12px;
        color: rgba(255,255,255,0.7);
    }

    .history-info {
        background: #f8f9fa;
        border: 1px solid #e5e9ed;
        border-radius: 7px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .history-info-label {
        font-size: 10px;
        font-weight: 700;
        color: #95a5a6;
        text-transform: uppercase;
    }

    .history-info-value {
        font-size: 13px;
        font-weight: 600;
        color: #2c3e50;
    }



    /* ==========================================
           TIMELINE
           ========================================== */

    .history-timeline {
        position: relative;
        padding-left: 35px;
    }

        .history-timeline::before {
            content: "";
            position: absolute;
            left: 10px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: #e5e9ed;
        }

    .history-item {
        position: relative;
        padding-bottom: 25px;
    }

        .history-item:last-child {
            padding-bottom: 0;
        }

    .history-icon {
        position: absolute;
        left: -35px;
        top: 0;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 10px;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 1px #dce1e5;
    }

    .history-completed {
        background: #18bc9c;
    }

    .history-processing {
        background: #f39c12;
    }

    .history-received {
        background: #3498db;
    }

    .history-title {
        font-size: 13px;
        font-weight: 600;
        color: #2c3e50;
    }

    .history-date {
        font-size: 11px;
        color: #95a5a6;
        margin-top: 2px;
    }

    .history-description {
        font-size: 12px;
        color: #7f8c8d;
        margin-top: 5px;
        margin-bottom: 0;
    }



    /* ==========================================
           RESPONSIVE
           ========================================== */

    @@media (max-width: 768px) {

        .document-table-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .tracking-table {
            min-width: 900px;
        }
    }



    /* ==========================================
           PRINT
           ========================================== */

    @@media print {

        .sidebar,
        .top-navbar,
        .filter-card,
        .no-print {
            display: none !important;
        }

        .main-wrapper {
            margin-left: 0 !important;
        }

        .content {
            padding: 0 !important;
        }

        .tracking-summary-card,
        .document-table-card {
            box-shadow: none !important;
        }
    }

</style>



<!-- ==========================================
     PAGE HEADER
     ========================================== -->

<div class="tracking-header">

    <h4>
        Document Tracking
    </h4>

    <p>
        Monitor document movement, status, and current assignment within the barangay office.
    </p>

</div>



<!-- ==========================================
     SUMMARY
     ========================================== -->

<div class="row g-3">


    <!-- TOTAL -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="tracking-summary-card">

            <div class="summary-icon summary-icon-blue">

                <i class="bi bi-file-earmark-text"></i>

            </div>

            <h3 class="summary-number">
                128
            </h3>

            <div class="summary-label">
                Total Documents
            </div>

        </div>

    </div>



    <!-- PROCESSING -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="tracking-summary-card">

            <div class="summary-icon summary-icon-orange">

                <i class="bi bi-clock-history"></i>

            </div>

            <h3 class="summary-number">
                47
            </h3>

            <div class="summary-label">
                Currently Processing
            </div>

        </div>

    </div>



    <!-- PENDING -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="tracking-summary-card">

            <div class="summary-icon summary-icon-gray">

                <i class="bi bi-hourglass-split"></i>

            </div>

            <h3 class="summary-number">
                12
            </h3>

            <div class="summary-label">
                Pending Documents
            </div>

        </div>

    </div>



    <!-- COMPLETED -->

    <div class="col-12 col-sm-6 col-xl-3">

        <div class="tracking-summary-card">

            <div class="summary-icon summary-icon-green">

                <i class="bi bi-check-circle"></i>

            </div>

            <h3 class="summary-number">
                62
            </h3>

            <div class="summary-label">
                Completed Documents
            </div>

        </div>

    </div>

</div>



<!-- ==========================================
     FILTERS
     ========================================== -->

<div class="filter-card">

    <div class="filter-title">

        <i class="bi bi-funnel me-1"></i>

        Document Filters

    </div>


    <div class="row g-3">


        <!-- SEARCH -->

        <div class="col-12 col-lg-5">

            <label class="filter-label">
                Search Document
            </label>

            <input type="text"
                   id="searchDocument"
                   class="form-control filter-control"
                   placeholder="Search document number or document name..."
                   onkeyup="filterDocuments()" />

        </div>



        <!-- STATUS -->

        <div class="col-12 col-md-6 col-lg-3">

            <label class="filter-label">
                Status
            </label>

            <select id="statusFilter"
                    class="form-select filter-control"
                    onchange="filterDocuments()">

                <option value="">All Status</option>

                <option value="Processing">
                    Processing
                </option>

                <option value="Pending">
                    Pending
                </option>

                <option value="For Approval">
                    For Approval
                </option>

                <option value="Completed">
                    Completed
                </option>

                <option value="Released">
                    Released
                </option>

            </select>

        </div>



        <!-- TYPE -->

        <div class="col-12 col-md-6 col-lg-3">

            <label class="filter-label">
                Document Type
            </label>

            <select id="typeFilter"
                    class="form-select filter-control"
                    onchange="filterDocuments()">

                <option value="">
                    All Types
                </option>

                <option value="Resolution">
                    Resolution
                </option>

                <option value="Certificate">
                    Certificate
                </option>

                <option value="Incoming">
                    Incoming
                </option>

                <option value="Outgoing">
                    Outgoing
                </option>

            </select>

        </div>



        <!-- RESET -->

        <div class="col-12 col-lg-1 d-flex align-items-end">

            <button type="button"
                    class="btn btn-outline-secondary w-100"
                    style="height:42px;"
                    onclick="resetFilters()"
                    title="Reset Filters">

                <i class="bi bi-arrow-clockwise"></i>

            </button>

        </div>

    </div>

</div>



<!-- ==========================================
     DOCUMENT MONITORING TABLE
     ========================================== -->

<div class="document-table-card">


