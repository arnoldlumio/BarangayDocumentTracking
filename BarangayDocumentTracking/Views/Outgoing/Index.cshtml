@model IEnumerable<BarangayDocumentTracking.Models.OutgoingDocument>

@{
    ViewData["Title"] = "Outgoing Documents";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">

    <h4>
        Outgoing Documents
    </h4>

    <p class="text-muted">
        Manage documents released by the barangay office.
    </p>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        <h5 class="mb-3">
            Outgoing Document List
        </h5>


        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>
                            Document No.
                        </th>

                        <th>
                            Recipient
                        </th>

                        <th>
                            Subject
                        </th>

                        <th>
                            Date Released
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-center">
                            Document
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var document in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @document.DocumentNumber
                                    </strong>
                                </td>


                                <td>
                                    @document.Recipient
                                </td>


                                <td>
                                    @document.Subject
                                </td>


                                <td>
                                    @document.DateReleased
                                        .ToString("MMMM dd, yyyy")
                                </td>


                                <td>

                                    @if (document.Status == "Released")
                                    {
                                        <span class="badge bg-success">
                                            Released
                                        </span>
                                    }
                                    else if (document.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @document.Status
                                        </span>
                                    }

                                </td>


                                <td class="text-center">

                                    <a asp-controller="Outgoing"
                                       asp-action="ViewDocument"
                                       asp-route-id="@document.Id"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-outline-danger">

                                        <i class="bi bi-file-earmark-pdf me-1"></i>

                                        View Document

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-5">

                                <i class="bi bi-folder2-open fs-1 text-muted"></i>

                                <p class="text-muted mt-3">
                                    No outgoing documents found.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>